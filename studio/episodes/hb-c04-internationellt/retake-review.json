        "speed": 0.95,
        "seed": 42,
        "path": "studio/media/hb-c04-internationellt/narration/hb-c04-u0068-s003.wav",
        "sample_rate": 44100,
        "seconds": 11.981496598639456,
        "peak": 0.32586669921875,
        "generation_seconds": 22.859650739002973
      }
    ],
    "asr": [
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0059-s001.wav",
        "sha256": "bd9d2cb287e77ce05493e0b3c222d8063109e43df90c8feb3b8d836d173ca354",
        "language": "sv",
        "asr_text": "Europeska unionen EU är en politisk och ekonomisk sammanslutning av stater."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0059-s002.wav",
        "sha256": "c7335f4decbd46cf2066e0eedbff94914f2e4ce53c88dffb878cabbf62b05c5f",
        "language": "sv",
        "asr_text": "År 2024 bestod den av 27 stater."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0059-s003.wav",
        "sha256": "f8dc354efa11eb6a28d5111a69c446107d0e9783d212d11e847e687d7205dd8c",
        "language": "sv",
        "asr_text": "Syftet med den är att främja fred och medborrenas välfärd och förbättra handeln och ekonomin i Europa."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0059-s004.wav",
        "sha256": "87c89fd7e3f259387f3321666097dae6f113e3491702e19ed89604d800f9958e",
        "language": "sv",
        "asr_text": "Medlemsländerna i EU är självständiga stater."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0059-s005.wav",
        "sha256": "e29a8f9680cf63899036a839b9b6e90166a32fea4789470e8677afad854919f9",
        "language": "sv",
        "asr_text": "De måste ändå följa unionens beslut och bestämmelser."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0060-s001.wav",
        "sha256": "b686668b7436094c91ca4baa8ab3c4ff29caded8f85ef71dbe45245cc773bc08",
        "language": "sv",
        "asr_text": "Europäiska unionens grundläggande värden är respekt för människans värdighet och de mänskliga rättigheterna, frihet, demokrati, jämställdhet och rättsstatsprincipen."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0061-s001.wav",
        "sha256": "f5cf924e5368772a5f36829109ab55e1617ba7e7522dc26ac26d6d471a54318c",
        "language": "sv",
        "asr_text": "Finland blev medlem i EU år 1995."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0061-s002.wav",
        "sha256": "716371c2fbae2da0983b6f0f0fbaddcb4e5cb4545f2959f404ef8e6db87f60ad",
        "language": "sv",
        "asr_text": "Då överfördes en del av det politiska beslutsfattandet i Finland till Europeska unionen."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0061-s003.wav",
        "sha256": "5397ce294363b1630a7b3069286ea4f095ada3efae500161b7bf59a46c24c344",
        "language": "sv",
        "asr_text": "EU-medlemskapet underlättar samarbetet med andra länder inom till exempel handeln."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0061-s004.wav",
        "sha256": "0a065c829102e6da9df733f87ed172b76b3779e80094b83bba5e0bdaf5f50038",
        "language": "sv",
        "asr_text": "Inom EU får människor var och tjänster röra sig fritt."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0061-s005.wav",
        "sha256": "102f3e64892dd9d2e903146b6499d6f241ce4fdf5c9665376a6602627308b644",
        "language": "sv",
        "asr_text": "Finländska politiker deltar i alla viktiga beslut om utvecklingen av EU."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0061-s006.wav",
        "sha256": "713b6474955c2c1c58cc9cb3e61a21cd49970982c2381bbea5d8f3ccb4057887",
        "language": "sv",
        "asr_text": "Samtidigt lyfter de upp frågor som är viktiga för finländarna."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0062-s001.wav",
        "sha256": "2eb4c85922cc7f4d950e40339c9c7df0d91a7342bcb12e9f1c5aaf2181c48c59",
        "language": "sv",
        "asr_text": "I EU fattas besluten av Europaparlamentet och ministerrådet."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0062-s002.wav",
        "sha256": "0a571a98ec80c2e680eff1b6b82dc3fcf71a28aa31907596e234df97349dc4df",
        "language": "sv",
        "asr_text": "Medlemmarna i Europa-parlamentet väls genom val i varje medlemsland."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0062-s003.wav",
        "sha256": "b5c57fd3ce1b515b96bf698d469ac8682c73d6bc6827039d5f57a1c55de64cd4",
        "language": "sv",
        "asr_text": "Parlamentet representerar, därför EU-ländernas medborgare."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0062-s004.wav",
        "sha256": "45a4776d6473a433fc8d96bd9e6645c60ad359c8bc123510ecaed54218b5983e",
        "language": "sv",
        "asr_text": "Ministerrådet i sin tur består av ministrar från EUs medlemsländer."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0062-s005.wav",
        "sha256": "1e8a06a8a125ef2d2a9d1886b11102538caada800302fb71c1f07cf209c54c86",
        "language": "sv",
        "asr_text": "Det representerar därför de nationella regeringarna."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0062-s006.wav",
        "sha256": "4a9345ca42f0a6a0582ba8b6c4fc6650688ead294d00edab50d17d5715089e67",
        "language": "sv",
        "asr_text": "Parlamentet och ministerrådet stiftar största delen av lagarna genom en medbeslutande procedur där parlamentet har en jämlik ställning med ministerrådet."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0062-s007.wav",
        "sha256": "d3a46d15cc992053a4b974c915373692916121d689ed66569cc00ffa0451c243",
        "language": "sv",
        "asr_text": "Ministerrådet ansvarar dock, för till exempel EUs, utrikes- och säkerhetspolitik."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0063-s001.wav",
        "sha256": "15eb690e24e8a339d2601fcb0f12fffd481c5c27c77f7d2dff1e056942192bd7",
        "language": "sv",
        "asr_text": "Europeska kommissionen i sin tur representerar själva unionen."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0063-s002.wav",
        "sha256": "0a3c180465b7d9b8719e728296f44a16429560c6be09d19350430fa8d97d37a2",
        "language": "sv",
        "asr_text": "Kommissionen gör lagförslag och förslag till EUs budget."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0063-s003.wav",
        "sha256": "8cb3c58778e409a9451bd1fed86fd596c1293453544d24117f375e8644d1bb23",
        "language": "sv",
        "asr_text": "Kommissionen verkställer också de beslut som parlamentet och ministerrådet fattar."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0063-s004.wav",
        "sha256": "7c98226d614121c33f32e9383bbacbb98de01b71addc97c21f5b6efc6d668641",
        "language": "sv",
        "asr_text": "I kommissionen arbetar tjänstemän som utnämts av medlemsländerna."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0064-s001.wav",
        "sha256": "2f80eeab5f427a1a2a1a3c8d142439574484088f54792c2b8fa623c08c91fbcb",
        "language": "sv",
        "asr_text": "Utöver Europeska unionen hör Finland också till NATO och föränta nationerna, FN."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0064-s002.wav",
        "sha256": "366838a0981dfd8707eadd3d7a158fde48326b5df297abb116ddfe15af662b10",
        "language": "sv",
        "asr_text": "Finland är också medlem i många olika slags andra internationella organisationer."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0064-s003.wav",
        "sha256": "b6a4c5ecc0da302835b24d8b8ca6a0b257f5abc1cc6edfe276ffdaa45870b350",
        "language": "sv",
        "asr_text": "Genom dem kan Finland påverka internationellt och främja sina utrikespolitiska mål."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0064-s004.wav",
        "sha256": "4616b5ada5742713b0d88d01cc7acd13b3c53416b299f109148e0f7fb79b486a",
        "language": "sv",
        "asr_text": "Till exempel i FN har Finland försökt främja fred runt om i världen genom fredsbevarande insatser."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0065-s001.wav",
        "sha256": "54b628b3096f14a8bcee4ce22ce539a3771f0df238d9dd838a32f45d50b6709b",
        "language": "sv",
        "asr_text": "Finland blev medlem i nordatlantiska fördragsorganisationen NATO år 2023."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0065-s002.wav",
        "sha256": "299f211b01c7f425326e1c575ab880a121aeea545c1fd1e0b9ba27879963dc2b",
        "language": "sv",
        "asr_text": "NATO är en politisk och militär allians med målet att främja säkerhet och frihet i sina medlemsländer."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0065-s003.wav",
        "sha256": "1a1a5dc1a69aaa1c3bb45f3e471de2bc9b6f4f58289c2c5fc5868ac652ff1d13",
        "language": "sv",
        "asr_text": "År 2024 var 32 länder medlemmar i NATO."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0065-s004.wav",
        "sha256": "e2eda3122b69e601a979810d36c41f5d61ade8b6c0a0e2f7beb4771529f92472",
        "language": "sv",
        "asr_text": "Största delen av medlemsländer ligger i Europa, förutom föränta staterna och Kanada."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0066-s001.wav",
        "sha256": "f3cbc8f737660295142de48d75fd9f2b7c63a19cbe50ab9167d2078cfb514596",
        "language": "sv",
        "asr_text": "Finland har varit medlem i föränta nationerna sedan år 1955."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0066-s002.wav",
        "sha256": "1598d1ed1f7780e64f12826b8e96c80c214994162c1134e31b2a83cc0deb4208",
        "language": "sv",
        "asr_text": "FN grundades år 1945 efter andra världskriget."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0066-s003.wav",
        "sha256": "d696304b3e457c1a2c7eaf44f8dcb5371d9c05b3d5215f1882799457ddd68f47",
        "language": "sv",
        "asr_text": "Syftet var att främja samarbetet mellan världens länder så att det aldrig mer skulle bli ett världskrig."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0066-s004.wav",
        "sha256": "9477ad6f5ef557a2a8bfc82f0729ec0f832461ca7297b014aeb1d7d87a17a99d",
        "language": "sv",
        "asr_text": "Idag är nästan alla länder i världen medlemmar i FM."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0066-s005.wav",
        "sha256": "b4659b7b6949b915fa3bacd48d608c5f4b5c662f635ca1a4d9bf02ed69b96921",
        "language": "sv",
        "asr_text": "År 2024 var antalet medlemsländer sammanlagt under 93."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0067-s001.wav",
        "sha256": "954c3e7eeb196b427ea6a0101a874f4f4496d7e15b32fb6de04cabff2a541ad8",
        "language": "sv",
        "asr_text": "Finland har undertecknat många internationella avtal som landet ska följa."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0067-s002.wav",
        "sha256": "b6c0b92bc2a890c8cafc0235ee77021d88f8046561bf1e36064210e38ddbf2f9",
        "language": "sv",
        "asr_text": "Avtalen kan vara bilaterala, det vill säga avtal som Finland har ingått med ett annat land."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0067-s003.wav",
        "sha256": "88e35089d78b333aeba0fee2e6ab53c2e228dd26aa169a103b509ab5c0ed1b3c",
        "language": "sv",
        "asr_text": "Avtalen kan också vara multilaterala, det vill säga avtal som ett antal länder har slutit tillsammans."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0068-s001.wav",
        "sha256": "e0822ffb11c855d83ab46046d29340c9d3466d4d789bb0da10cd9cf25f348de7",
        "language": "sv",
        "asr_text": "Exempel på internationella avtal är konventionerna om de mänskliga rättigheterna."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0068-s002.wav",
        "sha256": "50bd9936ebf0445474776f9f1e7435f7d7b4b6197f4c4ba7d34231d8b651995d",
        "language": "sv",
        "asr_text": "En del av konventionerna om de mänskliga rättigheterna gäller alla människors rättigheter. Andra i sin tur fokuserar särskilt på till exempel rättigheterna för barn eller personer med funktionsnedsättning."
      },
      {
        "file": "studio/media/hb-c04-internationellt/narration/hb-c04-u0068-s003.wav",
        "sha256": "d1fca38035becb2e3438248eebe0c1cebf0abd9b3532f4c79c6969c9873a3e1e",
        "language": "sv",
        "asr_text": "Andra internationella avtal i klimatavtal där världens länder har kommit överens om hur de ska försöka bromsa den globala uppvämningen."
      }
    ]
  },
