      "display_segments": [
        {
          "index": 0,
          "start_frame": 3187,
          "frames": 296,
          "sv": "De omfattar \u00e5tminstone en bed\u00f6mning av servicebehovet, uppr\u00e4ttande av en integrationsplan, handledning och r\u00e5dgivning medan integrationsprogrammet p\u00e5g\u00e5r,",
          "ru": "\u041e\u043d\u0438 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u043a\u0430\u043a \u043c\u0438\u043d\u0438\u043c\u0443\u043c \u043e\u0446\u0435\u043d\u043a\u0443 \u043f\u043e\u0442\u0440\u0435\u0431\u043d\u043e\u0441\u0442\u0438 \u0432 \u0443\u0441\u043b\u0443\u0433\u0430\u0445, \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u043d\u0430 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438, \u0441\u043e\u043f\u0440\u043e\u0432\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0432 \u0442\u0435\u0447\u0435\u043d\u0438\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u044b \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u0438,",
          "speech_offset_seconds": 0.0
        },
        {
          "index": 1,
          "start_frame": 3483,
          "frames": 341,
          "sv": "flerspr\u00e5kig samh\u00e4llsorientering och integrationsutbildning, utbildning i l\u00e4s- och skrivf\u00e4rdighet och sluttestning av spr\u00e5kkunskaperna.",
          "ru": "\u043c\u043d\u043e\u0433\u043e\u044f\u0437\u044b\u0447\u043d\u044b\u0439 \u043a\u0443\u0440\u0441 \u043e\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043e\u0440\u0438\u0435\u043d\u0442\u0430\u0446\u0438\u0438 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u043e\u043d\u043d\u043e\u0435 \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435, \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u0435 \u0447\u0442\u0435\u043d\u0438\u044e \u0438 \u043f\u0438\u0441\u044c\u043c\u0443 \u0438 \u0438\u0442\u043e\u0433\u043e\u0432\u0443\u044e \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u0437\u043d\u0430\u043d\u0438\u044f \u044f\u0437\u044b\u043a\u0430.",
