      },
      "url": "https://upload.wikimedia.org/wikipedia/commons/b/b7/Flag_of_Europe.svg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original",
      "descriptionurl": "https://commons.wikimedia.org/wiki/File:Flag_of_Europe.svg",
      "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=2615952",
      "extmetadata": {
        "DateTime": {
          "value": "2026-02-20 05:07:32",
          "source": "mediawiki-metadata",
          "hidden": ""
        },
        "ObjectName": {
          "value": "Flag of Europe",
