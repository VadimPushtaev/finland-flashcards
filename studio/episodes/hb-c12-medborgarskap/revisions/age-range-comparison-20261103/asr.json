[
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0246-s001.wav",
    "sha256": "cf83de550cdf9e91f27818630d4a7eaec8d357787f1b6a4754cdc3019a21ebe2",
    "language": "sv",
    "asr_text": "Du kan ansöka om finst medborgarskap om du har bott i Finland tillräckligt länge och bland annat lärt dig ett lokalt språk."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0246-s002.wav",
    "sha256": "999ce2614577e211e04f787f5ba64f6606891071a7b9480bedd6a8a162bc9018",
    "language": "sv",
    "asr_text": "Du kan även få medborgarskapet av en förälder som är finsk medborgare."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0247-s001.wav",
    "sha256": "7f00de6dfd3b9f4947225e3f0de1ba15a998c82e8785d1ecd998eaab55410cc5",
    "language": "sv",
    "asr_text": "I vissa situationer kan man få medborgarskap även genom anmälan."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0247-s002.wav",
    "sha256": "7ca726ae62a610d64c1fa46a7815b28beb1ee0e71df02693c22a99104ca169a8",
    "language": "sv",
    "asr_text": "I vissa undantagsfall kan man dessutom få medborgarskap på grundval av att man är född i Finland."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0248-s001.wav",
    "sha256": "82c7c2e9142e18adae145a7d413a55744978b21517f56f6e84eccc2537dc26e3",
    "language": "sv",
    "asr_text": "Finst medborgarskap är inte samma sak som uppehålls tillstånd."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0249-s001.wav",
    "sha256": "3aa5c0f23ab3bca1a42d811642d24d7977a863d9180705b482664d49d766dfac",
    "language": "sv",
    "asr_text": "Barnet får automatiskt finskt medborgarskap vid födsäljning i följande fall."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0250-s001.wav",
    "sha256": "faa35a93ff2ebdc35d06b74f0ef5e42103eba67ac8df9fdf116f3d69a138dd12",
    "language": "sv",
    "asr_text": "Barnets mor är finsk medborgare."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0252-s001.wav",
    "sha256": "0b5cbcba6e9b9b69f9f0446abc3f222e9de5be12b433fd9fa74643348916c814",
    "language": "sv",
    "asr_text": "Barnets far är finsk medborgare och gift med barnets mor."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0253-s001.wav",
    "sha256": "cdc427bfb4195085a13733cf48e2192fc9bbe0be884e4e75ebfbd93f2ab026e3",
    "language": "sv",
    "asr_text": "Barnet föds i Finland. Barnets far är finsk medborgare och faderskapet har bekräftats eller."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0254-s001.wav",
    "sha256": "b51b8e05893f31b534f3b6a576378ed54d5cf36a49ee84a6fb971693f02b476f",
    "language": "sv",
    "asr_text": "Barnet föds i Finland. Barnets mor som inte har fött barnet är finsk medborgare och den icke födande modern smoderskap har bekräftats den 1 april 2019 eller senare."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0255-s001.wav",
    "sha256": "7c8499c9a69c2c8eecc67210ecea586be2be14e8f9e13b1e8da0b3a5fa2864c0",
    "language": "sv",
    "asr_text": "Barnet kan få finst medborgarskap genom anmälan om barnet föds utomlands, har en finsk far eller en finsk mor som inte har fött barnet och föräldrarna inte är gifta med varandra."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0256-s001.wav",
    "sha256": "5c2da785c4955645eb0c6ef4df68b7050f104f8fcfaae8cb1ae5821663b961cc",
    "language": "sv",
    "asr_text": "Också ett barn till utländska föräldrar som föds i Finland kan få finst medborgarskap om henne inte får medborgarskap i något annat land av sina föräldrar."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0257-s001.wav",
    "sha256": "041c3648782bed262c9243756cb375c050f599f9b38836fd0826cd25394d226d",
    "language": "sv",
    "asr_text": "Följande personer kan få finst medborgarskap snabbare och förmånligare genom medborgarskapsanmälan."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0258-s001.wav",
    "sha256": "c804422b3ddeee4cc4ef5a79656d5a86996ef3b867cda402be845ed7ff55833a",
    "language": "sv",
    "asr_text": "Tidigare finsk medborgare."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0260-s001.wav",
    "sha256": "141e25d9737f66c3abc62ed762b084cf64660fe9579c998f6498ea8e74cd195d",
    "language": "sv",
    "asr_text": "Ett barn som föds utomlands utom äktenskapet till en finsk far eller till en finsk mor som inte har fött barnet."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0261-s001.wav",
    "sha256": "c1c090e39706eba17e2199d52395a87c7ddeb2b74176b5d55b37075c884bdb32",
    "language": "sv",
    "asr_text": "1822 år gamla personer som har bott i Finland flera år."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0262-s001.wav",
    "sha256": "a99e3d3f23129f45bc16b6a37ed05c8c50e4e14a1e4c88e5c1126daa0ab3be4a",
    "language": "sv",
    "asr_text": "1217 år gammalt adoptivban till en finsk medborgare."
  },
  {
    "file": "studio/media/hb-c12-medborgarskap/narration/hb-c12-u0263-s001.wav",
    "sha256": "535bf01d039f6bb228aec676a3ecf48dcf899d43364b79d5e05fa7d9a43ecb77",
    "language": "sv",
    "asr_text": "Medborgare är ett nordiskt land som har bott i Finland de senaste fem åren."
  }
]
