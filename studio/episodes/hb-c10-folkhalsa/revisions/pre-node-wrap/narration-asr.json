[
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0026-s001.wav",
    "sha256": "7ce66b9a07f4a4a9bafa9183bd10b173f7e5af76c7fed8d9a17c2f60465c9be7",
    "language": "sv",
    "asr_text": "En frisk människa mår bra fysiskt, psykiskt och socialt."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0026-s002.wav",
    "sha256": "7f7f9fbe71cbf9e45246638ea8c7ec04a068517d3b880099e2726104e01b70c9",
    "language": "sv",
    "asr_text": "Hen klarar av uppgifterna och utmaningarna i det dagliga livet."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0026-s003.wav",
    "sha256": "3ea7105c7492ba6e328cc22e62960c5234846ec6918d0a6f43b626a9503a9e1f",
    "language": "sv",
    "asr_text": "Hälsa betyder inte bara att en människa inte har någon sjukdom."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0026-s004.wav",
    "sha256": "e4b9add7374ba8ae0d5f8a316feb61ab6830f744f4ddc150ee25fa67fcdf938d",
    "language": "sv",
    "asr_text": "Det är människans förmåga att fungera i vardagen."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0027-s001.wav",
    "sha256": "cd21ae17d6067389739b2cbc71a00939a8a376c9828e7755d069cfb900b781d8",
    "language": "sv",
    "asr_text": "En frisk människa klarar av att göra sådant i sitt liv, som är meningsfullt för henne, till exempel studera, utöva hobbyer, arbeta eller ha ett socialt liv."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0027-s002.wav",
    "sha256": "6b86dd1dd4b433625564df0ef2ef547817d3eb33fb96388b3c6d925867491a24",
    "language": "sv",
    "asr_text": "Om en människa blir sjuk eller skadar sig allvarligt kan henne ofta bli tvungen att ge upp sådant som är viktigt för henne."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0027-s003.wav",
    "sha256": "0f613200e4e80e3f1dbe28001c7d2b1f4880f2936d3a96e7a2cae493df8bdc92",
    "language": "sv",
    "asr_text": "En människa kan ändå uppleva att hän är handlingskraftig och välmående, trots att hän har en långvarig sjukdom."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0027-s004.wav",
    "sha256": "94885b550ed2fd177aa2961579c8f4254db7888f529c79d9c6e71bc2d6645a18",
    "language": "sv",
    "asr_text": "Om sjukdomen behandlas kan människan leva ett gott liv trots sjukdomen."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0028-s001.wav",
    "sha256": "526c670cdef7d00714ccb12c2d9894e30a8eb2abf8e0d403715300218f4e5ada",
    "language": "sv",
    "asr_text": "En del sjukdomar skador åkom och reakuta, det vill säga plötsliga och kortvariga."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0028-s002.wav",
    "sha256": "a5e80a49f50b36905ef7f70a07b3f701160136323f9cf3023689a411291d27b1",
    "language": "sv",
    "asr_text": "Sådana är till exempel många inflammationer, influenser och skador."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0028-s003.wav",
    "sha256": "09592b4f7d7eed194fca8cc7d953aa1d81e6d5d4e790fd4de7696d82c20207f9",
    "language": "sv",
    "asr_text": "En del sjukdomar är kroniska. Det vill säga långvariga eller bestående."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0029-s001.wav",
    "sha256": "0f706ff0341f8ad56edb9fea368920a5d8e862cada2d91f9495c6caa56adea51",
    "language": "sv",
    "asr_text": "Många olika faktorer påverkar en människas hälsa."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0029-s002.wav",
    "sha256": "7c6515e8cc6b9add61d8b11e476b0e15f12d1d56037b1287e4ac9008c5aebc18",
    "language": "sv",
    "asr_text": "Det är lättare för henne att hålla sig frisk om henne har tillgång till goda hälsovårdstjänster."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0029-s003.wav",
    "sha256": "d31f2351c4278ca82c53a865f11470595f3ddfbc23d9a1e27fafe46f7a8a0757",
    "language": "sv",
    "asr_text": "Tjänsterna hjälper människor att ha ett sunt levnadssätt."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0029-s004.wav",
    "sha256": "6d485de8757ccd6a6c998b51f617910a93853b8367c8a90cca05308b22624098",
    "language": "sv",
    "asr_text": "Med hjälp av tjänsterna kan många sjukdomar konstateras i ett tidigt skede och då bättre behandlas."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0030-s001.wav",
    "sha256": "6335464c7c908ce94495c670f01670645eac4e0ae4d7257b9ad372a4acfba8b6",
    "language": "sv",
    "asr_text": "Hälsa och välbefinnande främjas också på många andra sätt, till exempel."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0031-s001.wav",
    "sha256": "becbebdb76ac9cab6aa5b928ae6fc57719e896226715e2559e63e815811e874d",
    "language": "sv",
    "asr_text": "En mångsidig och näringsrik kost."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0033-s001.wav",
    "sha256": "84cc312189ecbbc85cffc82cbea2afd184861d75aff78e451c999c89979030f1",
    "language": "sv",
    "asr_text": "Fysisk aktivitet och motion."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0034-s001.wav",
    "sha256": "86e6d008575a5016c678557fc8e5109ba885c3dd528d4c302c93a79310ddbfd7",
    "language": "sv",
    "asr_text": "Tillräckligt med sömn och vila."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0035-s001.wav",
    "sha256": "24daff09296d4246ebc1e6d5d1ccad05256f9a5d45942c6f686c6d924e2ba4b1",
    "language": "sv",
    "asr_text": "Tillräcklig utkomst."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0036-s001.wav",
    "sha256": "d1afaa86627aa69975009b8698cec61d61d6cde46052f283894565cbf8add0b2",
    "language": "sv",
    "asr_text": "Själviga boendeförhållanden"
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0037-s001.wav",
    "sha256": "454ad9274f101538382af29b6fce98a449a3d882baa7765a78e5cb0367904983",
    "language": "sv",
    "asr_text": "Goda sociala relationer."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0038-s001.wav",
    "sha256": "47c09975583e8b55044b69cdce1a89a6f4eda1b8ce1c92ad10a955f55b827297",
    "language": "sv",
    "asr_text": "fred i samhället"
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0039-s001.wav",
    "sha256": "7a1a862e08280da6e7456707bd7ad66ba3433141ca307039d7b7d711e9dfc63d",
    "language": "sv",
    "asr_text": "Ett rättvist och demokratiskt samhälle."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0040-s001.wav",
    "sha256": "fda8e715501801487fd3ae5a44d9b55f2aecb268b8f2d74134d1385b465beabd",
    "language": "sv",
    "asr_text": "Tillräcklig utbildning"
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0041-s001.wav",
    "sha256": "73d44d66192e09d7219587ec73497f14ccd4b2a34952d11327de084319e86118",
    "language": "sv",
    "asr_text": "möjlighet att arbeta eller bedriva annan nyttig verksamhet i samhället."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0042-s001.wav",
    "sha256": "5a90e200c541a7fac4b9ceea2768879a471f6f13c014bf736c3e8dd7ca369add",
    "language": "sv",
    "asr_text": "Det finländska välfärdsamhället ser på många sätt till att människor håller sig så friska som möjligt."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0042-s002.wav",
    "sha256": "8d5ab9c07b4c0bef94708d50b7f379cf1d2e30251ecbf3f083167810a95e8c6b",
    "language": "sv",
    "asr_text": "För det har det stiftats lagar i syfte att främja medborgarnas hälsa."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0042-s003.wav",
    "sha256": "0b32fe6ec8c1def18f90fb0aa2c08640c59ba30bf3c66d1a1b730514581395d5",
    "language": "sv",
    "asr_text": "Ett exempel är tobakslagen som begränsar tobaksrökning på offentliga platser."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0042-s004.wav",
    "sha256": "5308c67352c7c9252ab3cd56a512e9152990a57cff5c9e437666e6a11b0e6f5b",
    "language": "sv",
    "asr_text": "Rökning är ohälsosam och orsakar sjukdomar för rökarna själva och för dem som är tvungna att andas in tobaksröken."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0043-s001.wav",
    "sha256": "5116de84feb7a9effa8bbf9d136e88417c76ab3e57d7713cedcaeffad510e638",
    "language": "sv",
    "asr_text": "I Finland samlar man hela tiden in forskningsdata om människors hälsa och sjukdomar."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0043-s002.wav",
    "sha256": "3a108b8aba45c28b7db93ed0208bdd6a1e1a0119e11e8418f5767c7c90f7b88f",
    "language": "sv",
    "asr_text": "Med hjälp av informationen kan man i samhället planera och genomföra program som främjar hälsan."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0043-s003.wav",
    "sha256": "0ad7c0ac1b321e15bc3d14cdfddc46e937aeab603dd2f0e074fbffd41f0bd156",
    "language": "sv",
    "asr_text": "Programmen kan gälla till exempel hjärt- och kärlsjukdomar eller cancersjukdomar."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0044-s001.wav",
    "sha256": "f133aea6a286243ec4fd31170ed83426f539fc5fa59bf5959c9466de662a4e0b",
    "language": "sv",
    "asr_text": "I Finland arbetar också olika organisationer mycket för att främja hälsa."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0044-s002.wav",
    "sha256": "aa6b94ab1989ed841fcb604db015ff280bbadd675c3eec2e57a19110608e7841",
    "language": "sv",
    "asr_text": "För många långtidssjuka finns egna föreningar som kan ge dem sjuka och deras närstående stöd och information."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0045-s001.wav",
    "sha256": "e207059c74d4711d8990312052b50552899e370cee2c1f07c00fa3b2f23eaa3f",
    "language": "sv",
    "asr_text": "Inom den grundläggande utbildningen för barn är hälso kunskap ett separat läroämne."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0045-s002.wav",
    "sha256": "2ea92ffe43df86ea1c7755126545b153afe97990d3135dd21ffd18af31672c3f",
    "language": "sv",
    "asr_text": "Syftet med undervisningen i hälsokunskap är att främja elevernas kunskaper om hälsa, välbefinnande och säkerhet."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0046-s001.wav",
    "sha256": "5d769bc27aed07347ba157406e9d7721f27741427ab52131d9fa3d96c785a280",
    "language": "sv",
    "asr_text": "Människorna hälsa observeras också med hjälp av screeningar."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0046-s002.wav",
    "sha256": "206f11ab3e5c83f3a4a925b3845349c9f6edba97bfafb7c804f7f5a48be0ca68",
    "language": "sv",
    "asr_text": "En screening är en undersökning där man letar efter tecken på allvarlig sjukdom."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0046-s003.wav",
    "sha256": "10e901b746a85d3be33076413a01bfe47a741e3befbbb1b103cda91bba244524",
    "language": "sv",
    "asr_text": "Exempel på sådana sjukdomar kan vara till exempel livmoderhalskanser, bröstkanser eller tarmkanser."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0046-s004.wav",
    "sha256": "3103e3f53147af1b19810bce37bdc7e54b4a94c7bbee8242dbca37c0abc99c18",
    "language": "sv",
    "asr_text": "Behandlingsresultaten blir bättre när sjukdomar upptäcks i ett tidigt skede."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0047-s001.wav",
    "sha256": "b6d2665dc2d4e9b13c2e0996a597f483f7a1f35c5f787728f6989d86d7a2e94f",
    "language": "sv",
    "asr_text": "I Finland är det lätt att hitta information om hur man främjar sin hälsa och sitt välbefinnande, till exempel på internet, biblioteken, hos läkaren eller olika hälsoorganisationer."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0047-s002.wav",
    "sha256": "78dd80aacea45601e544791fd11774b957d430320dd27eaac52b63c48ab3ccc5",
    "language": "sv",
    "asr_text": "Dessutom erbjuder välfärdsområdena och olika organisationer och företag många olika slags vårtjänster, motionsgrenar, välbefinnande rådgivning och kostrådgivning samt olika kultursjänster."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0047-s003.wav",
    "sha256": "942c52bfd6dcbeeeecb9fb4865a1f02712b61a185e4d7f778fd73071a01ffd8a",
    "language": "sv",
    "asr_text": "De hjälper folk att hålla sig friska och må bra."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0047-s004.wav",
    "sha256": "80ebcae0aeaf0a5eb0a6b2c0e72b395899aa2888e4e3942f217a9f8560989ad4",
    "language": "sv",
    "asr_text": "För barn är skolan en viktig uppväxtmiljö som ger deras vardagsstruktur och därom också lär sig att främja hälsa och välbefinnande."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0048-s001.wav",
    "sha256": "f96b966eccab3713f160f35fb654e0d7affacf5dee7a4ced8d1c9449bc52a035",
    "language": "sv",
    "asr_text": "I Finland kan barnen vaccineras, rokotus, mot många smittsamma sjukdomar."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0048-s002.wav",
    "sha256": "b4fca9c7bc10ae894f3b5e36977994965ba155e146f165aee6ed749e78d38505",
    "language": "sv",
    "asr_text": "Vaccinationerna ges på barnrådgivningen Lastenuvola och inom Skolhälsovården."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0048-s003.wav",
    "sha256": "929abd751221fa401d9ce74b231eff06b39667c08c4a850202059bf31f3e5e0a",
    "language": "sv",
    "asr_text": "De vaccinationer som ingår i vaccinationsprogrammet är avgiftsfria för familjen."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0048-s004.wav",
    "sha256": "1d18d5d1c5e0f0ead788092dfcf14fc3e99dce158e1d925a4927a2b86e058fa3",
    "language": "sv",
    "asr_text": "Vaccinationerna är frivilliga."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0048-s005.wav",
    "sha256": "ab64c871367a2356d65bcc3374ceda4f65c86935365b67441647e274503c965f",
    "language": "sv",
    "asr_text": "De flesta barn i Finland får de vaccinationer som ingår i vaccinationsprogrammet."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0048-s006.wav",
    "sha256": "41fe15c0bc933c42dab68ac0f1c12f92c986941fe268c7f0581fc0d214eb8a88",
    "language": "sv",
    "asr_text": "Berätta för hälsovårdar en vilka vaccinationer ditt barn har fått innan ni kom till Finland."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0049-s001.wav",
    "sha256": "36aa176281bd44782ae21beeb0a92a1aa1e123813a63c81bcb5f75c32c965b8d",
    "language": "sv",
    "asr_text": "I Finland finns ett vaccinationsprogram, enligt vilket alla barn erbjuds kostnadsfria vaccinationer mot fler livsfarliga sjukdomar."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0049-s002.wav",
    "sha256": "873fe084f28eb7bb77e2f738523f4994f834b4b33fa50990be9365ddc543ccc8",
    "language": "sv",
    "asr_text": "Vaccinationer erbjuds mot bland annat polio, ställkramp, dyfteri, kikhosta, mässling och påsjuka."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0050-s001.wav",
    "sha256": "b07dea560cc2b5d8731205ca23d6aef8db3a24863786b7f1e31c519f6569ec8e",
    "language": "sv",
    "asr_text": "Om du ingår i en riskgrupp för influenza kan du också få en kostnadsfri vaccination mot influenza."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0050-s002.wav",
    "sha256": "3547fe4a512e2f410673eab6463d99217400ff90ad92283d7727cd0bddaf0787",
    "language": "sv",
    "asr_text": "Detta gäller för både vuxna och barn."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0051-s001.wav",
    "sha256": "4b10ef9f78e8c6ad8579a174ee199f35e2b9288aa4d46ce153b54eee3743593e",
    "language": "sv",
    "asr_text": "När du flyttar till Finland ska du ta reda på vilka vaccinationer enligt vaccinationsprogrammet du saknar."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0051-s002.wav",
    "sha256": "dabd47fac6fd9a9c8a354e31ae83fde2079dad463d852e97251972814d82bfe5",
    "language": "sv",
    "asr_text": "Om du inte har fått alla vaccinationer enligt vaccinationsprogrammet kan du få dem kostnadsfritt om du flyttar till Finland stadigvarande."
  },
  {
    "file": "studio/media/hb-c10-folkhalsa/narration/hb-c10-u0052-s001.wav",
    "sha256": "295c917951c1e2e49e5ff05cb6ad5d663abc69f9fd3cf3acfbd16f90bcf50977",
    "language": "sv",
    "asr_text": "Om du har ansökt om asyl eller tillfälligt skydd i Finland kan du få vaccinationerna om du är mindre årig eller gravid."
  }
]
