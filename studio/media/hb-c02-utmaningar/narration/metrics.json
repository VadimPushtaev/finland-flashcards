    "generation_seconds": 41.727590212016366
  },
  {
    "sentence_id": "hb-c02-u0086-s002",
    "text": "En av utmaningarna är en försämrad demografisk försörjningskvot.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
