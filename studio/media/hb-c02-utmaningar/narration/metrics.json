    "generation_seconds": 32.77865936001763
  },
  {
    "sentence_id": "hb-c02-u0086-s004",
    "text": "I Finland, liksom i övriga industriländer, finns det allt fler äldre och allt färre människor i arbetsför ålder i förhållande till befolkningen som helhet.",
    "engine": "supertonic",
    "voice": "F1",
