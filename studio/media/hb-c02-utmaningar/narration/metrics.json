    "generation_seconds": 22.148895532009192
  },
  {
    "sentence_id": "hb-c02-u0086-s003",
    "text": "Med det avses att det i landet föds färre barn än tidigare, samtidigt som människorna lever allt längre.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
