    "generation_seconds": 21.351013400009833
  },
  {
    "sentence_id": "hb-c02-u0085-s004",
    "text": "Finland blev en liberal demokrati, vars grundlag skyddar alla människors rättigheter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
