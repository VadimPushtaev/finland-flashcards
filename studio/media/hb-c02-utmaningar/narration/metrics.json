    "generation_seconds": 38.3090948809986
  },
  {
    "sentence_id": "hb-c02-u0087-s001",
    "text": "Välfärdsstaten finansieras i huvudsak med skattemedel och därför är det av avgörande betydelse att det finns tillräckligt med skattebetalare.",
    "engine": "supertonic",
    "voice": "F1",
