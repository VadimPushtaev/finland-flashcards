    "generation_seconds": 32.85835676797433
  },
  {
    "sentence_id": "hb-c03-u0096-s004",
    "text": "Konfirmationen föregås av en skriftskola som innehåller religionsundervisning och som nuförtiden ofta hålls i form av ett sommarläger.",
    "engine": "supertonic",
    "voice": "F1",
