    "generation_seconds": 26.099868685996626
  },
  {
    "sentence_id": "hb-c03-u0096-s002",
    "text": "Konfirmationen är en ceremoni som hålls i kyrkan.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-livets-fester/narration/hb-c03-u0096-s002.wav",
