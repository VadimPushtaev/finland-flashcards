    "generation_seconds": 39.555577541992534
  },
  {
    "sentence_id": "hb-c03-u0096-s001",
    "text": "I Finland kan barn konfirmera sig det år de fyller femton.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-livets-fester/narration/hb-c03-u0096-s001.wav",
    "sample_rate": 44100,
