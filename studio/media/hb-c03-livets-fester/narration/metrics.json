    "generation_seconds": 23.81513217894826
  },
  {
    "sentence_id": "hb-c03-u0096-s003",
    "text": "Där bekräftas den ungas kristna tro och medlemskapet i församlingen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
