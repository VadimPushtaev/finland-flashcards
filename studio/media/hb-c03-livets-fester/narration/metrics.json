    "generation_seconds": 38.85735480801668
  },
  {
    "sentence_id": "hb-c03-u0095-s003",
    "text": "I dag tänker man mera att barnet är en särskilt viktig människa i fadderns liv och faddern följer barnets uppväxt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
