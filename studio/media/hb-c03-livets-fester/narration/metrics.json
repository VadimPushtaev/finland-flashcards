    "generation_seconds": 23.871030339971185
  },
  {
    "sentence_id": "hb-c03-u0095-s002",
    "text": "Ursprungligen var fadderns uppgift att vara en slags andlig förälder åt barnet och sköta om barnets kristna fostran.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-livets-fester/narration/hb-c03-u0095-s002.wav",
    "sample_rate": 44100,
    "seconds": 10.100680272108843,
