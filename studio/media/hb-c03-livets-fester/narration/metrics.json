    "generation_seconds": 87.14116318203742
  },
  {
    "sentence_id": "hb-c03-u0097-s001",
    "text": "En del unga deltar vid samma ålder i ett Prometheus-läger som är ett religiöst och politiskt obundet livssynsläger.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-livets-fester/narration/hb-c03-u0097-s001.wav",
