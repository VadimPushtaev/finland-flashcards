    "sample_rate": 44100,
    "seconds": 11.842176870748299,
    "peak": 0.24853515625,
    "generation_seconds": 55.47462201799499
  },
  {
    "sentence_id": "hb-c03-u0096-s005",
    "text": "En stor del av de unga deltar i skriftskollägret och konfirmationen för att det är roligt på lägret, för att föräldrarna förväntar sig att barnen ska göra det och för att det efter konfirmationen ordnas en fest hemma där den unga får presenter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-livets-fester/narration/hb-c03-u0096-s005.wav",
    "sample_rate": 44100,
