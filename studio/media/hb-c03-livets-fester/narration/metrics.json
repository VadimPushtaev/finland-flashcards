    "generation_seconds": 39.83372718899045
  },
  {
    "sentence_id": "hb-c03-u0097-s002",
    "text": "Lägrets syfte är att uppmuntra de unga till att utveckla sin egen livssyn.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
