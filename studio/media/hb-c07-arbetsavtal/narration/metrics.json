  {
    "sentence_id": "hb-c07-u0057-s001",
    "text": "Arbetet och arbetets karaktär har förändrats mycket i Finland under de senaste årtiondena.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0057-s001.wav",
