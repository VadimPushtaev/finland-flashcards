    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0073-s003",
    "text": "Annars kan arbetsavtalet endast sägas upp om det finns mycket vägande skäl till detta.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
