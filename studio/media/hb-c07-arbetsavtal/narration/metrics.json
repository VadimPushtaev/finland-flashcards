    "generation_seconds": 17.42606866103597,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0057-s005",
    "text": "Andelen deltidsarbeten och korta anställningar, det vill säga kortjobb, har ökat.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0057-s005.wav",
    "sample_rate": 44100,
    "seconds": 7.035646258503402,
    "peak": 0.391937255859375,
    "generation_seconds": 15.538927208981477,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0058-s001",
    "text": "Ett arbetsavtal kan antingen gälla tills vidare, det vill säga vara fast, eller vara tidsbegränsat.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0058-s001.wav",
    "sample_rate": 44100,
    "seconds": 8.568163265306122,
    "peak": 0.581451416015625,
    "generation_seconds": 20.02591406099964,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0058-s002",
    "text": "Alla anställda måste ändå behandlas jämlikt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0058-s002.wav",
    "sample_rate": 44100,
    "seconds": 4.249251700680272,
    "peak": 0.391510009765625,
    "generation_seconds": 14.481904483982362,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0058-s003",
    "text": "Visstidsanställda eller deltidsanställda får inte ha sämre arbetsvillkor än fast anställda eller heltidsanställda.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0058-s003.wav",
    "sample_rate": 44100,
    "seconds": 10.170340136054422,
    "peak": 0.41259765625,
    "generation_seconds": 28.95285298197996,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0059-s001",
    "text": "Ett arbetsavtal som gäller tills vidare innebär att anställningsförhållandet är fortlöpande, det vill säga fast eller ordinarie.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0059-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.866938775510205,
    "peak": 0.32177734375,
    "generation_seconds": 27.163307504029945,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0059-s002",
    "text": "Arbetsgivaren eller den anställda kan vid behov säga upp avtalet, men i sådana fall iakttas en uppsägningstid.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0059-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.543401360544218,
    "peak": 0.515838623046875,
    "generation_seconds": 26.62300463905558,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0060-s001",
    "text": "Om en arbetsgivare säger upp en anställd måste hen ha ett sakligt och vägande skäl till det.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0060-s001.wav",
    "sample_rate": 44100,
    "seconds": 8.010884353741497,
    "peak": 0.361480712890625,
    "generation_seconds": 21.356145798927173,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0060-s002",
    "text": "Ett giltigt skäl kan vara till exempel företagets dåliga ekonomiska läge eller att den anställda på ett allvarligt sätt har försummat sina uppgifter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0060-s002.wav",
    "sample_rate": 44100,
    "seconds": 12.469115646258503,
    "peak": 0.4884033203125,
    "generation_seconds": 34.814151630038396,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0060-s003",
    "text": "Om det är fråga om försummelse ska den anställda höras och ges en varning före uppsägningen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0060-s003.wav",
    "sample_rate": 44100,
    "seconds": 8.219863945578231,
    "peak": 0.292388916015625,
    "generation_seconds": 22.15514789998997,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0060-s004",
    "text": "Om den anställda är frånvarande från arbetsplatsen i sju dagar utan att meddela något godtagbart skäl till frånvaron, betraktas anställningsförhållandet som upphävt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0060-s004.wav",
