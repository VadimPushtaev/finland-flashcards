    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0061-s002",
    "text": "Om en anställd säger upp sig och blir arbetslös, får hen i allmänhet ingen arbetslöshetsförmån genast, utan först efter en viss tid.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
