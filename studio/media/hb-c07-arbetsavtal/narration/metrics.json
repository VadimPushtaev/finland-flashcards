    "seconds": 14.280272108843537,
    "peak": 0.3873291015625,
    "generation_seconds": 39.06359098595567,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0061-s001",
    "text": "En anställd kan säga upp sig utan att uppge något skäl.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0061-s001.wav",
