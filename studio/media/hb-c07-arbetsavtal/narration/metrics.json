    "generation_seconds": 21.553344542044215,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0057-s003",
    "text": "Numera är arbetet inte lika oföränderligt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0057-s003.wav",
    "sample_rate": 44100,
    "seconds": 4.1099319727891155,
