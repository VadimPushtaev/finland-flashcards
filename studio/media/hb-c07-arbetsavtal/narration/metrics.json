    "seconds": 7.9412244897959186,
    "peak": 0.489105224609375,
    "generation_seconds": 17.506317500025034,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0057-s002",
    "text": "Tidigare arbetade en stor del av människorna heltid på samma arbetsplats i många år eller till och med hela sin karriär.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0057-s002.wav",
