    "generation_seconds": 9.554093740996905,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0057-s004",
    "text": "En del utför många olika arbeten samtidigt för olika arbetsgivare.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetsavtal/narration/hb-c07-u0057-s004.wav",
    "sample_rate": 44100,
    "seconds": 5.990748299319728,
