    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0197-s003",
    "text": "I lagen fastslås bland annat hur djur ska skötas, uppfödas och slaktas och i hurudana omständigheter djuren inte får hållas.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0197-s003.wav",
