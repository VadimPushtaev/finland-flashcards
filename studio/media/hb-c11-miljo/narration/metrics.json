    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0197-s002",
    "text": "Djurskyddslagen främjar djurens välmående och en bra behandling av djuren i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
