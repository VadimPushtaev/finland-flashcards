    "generation_seconds": 20.249164620880038,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0193-s001",
    "text": "Klimatförändringen innebär att temperaturen på jorden gradvis ökar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0193-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.990748299319728,
