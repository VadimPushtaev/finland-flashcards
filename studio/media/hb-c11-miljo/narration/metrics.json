    "seconds": 7.035646258503402,
    "peak": 0.352996826171875,
    "generation_seconds": 18.9144963840954,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0192-s005",
    "text": "Ju mindre energi som förbrukas, desto bättre kan vi skydda jorden mot klimatförändringen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0192-s005.wav",
    "sample_rate": 44100,
    "seconds": 7.732244897959184,
