    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0196-s001",
    "text": "I Finland skyddas naturen av finsk lag, E U-lagstiftning, statliga myndigheter och olika frivilligorganisationer.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
