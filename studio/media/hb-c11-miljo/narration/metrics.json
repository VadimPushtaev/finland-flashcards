    "generation_seconds": 15.514839611016214,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0193-s002",
    "text": "Klimatförändringen har många allvarliga konsekvenser för människornas och djurens liv på hela jordklotet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0193-s002.wav",
