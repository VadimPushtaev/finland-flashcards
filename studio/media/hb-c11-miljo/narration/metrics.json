    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0196-s003",
    "text": "Det övervakar bland annat att naturresurserna utnyttjas hållbart och att naturens mångfald bevaras.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
