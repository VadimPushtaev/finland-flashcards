    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0193-s004",
    "text": "De extrema väderfenomenen blir kraftigare, vilket innebär att det på torra platser blir allt torrare och varmare och på andra platser fuktigare eller kallare.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0193-s004.wav",
