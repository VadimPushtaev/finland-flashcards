    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0194-s001",
    "text": "Sjukdomar sprider sig, och djurarter dör ut.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0194-s001.wav",
