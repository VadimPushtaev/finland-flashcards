    "generation_seconds": 33.27704683714546,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0193-s005",
    "text": "Förändringarna orsakar fara för både människorna, djuren och hela vår livsmiljö.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
