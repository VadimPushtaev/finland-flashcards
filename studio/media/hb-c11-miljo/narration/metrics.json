    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0197-s001",
    "text": "I Finland ska både vilda djur, husdjur och sällskapsdjur behandlas etiskt och korrekt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
