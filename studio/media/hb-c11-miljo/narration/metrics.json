    "generation_seconds": 24.1951518189162,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0193-s003",
    "text": "När temperaturen på jorden ökar blir det svårare och svårare att bedriva jordbruk.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0193-s003.wav",
