    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0195-s001",
    "text": "Naturen skyddas för att man vill bevara djur- och växtarter och skydda naturens mångfald mot påverkan från mänsklig verksamhet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0195-s001.wav",
