[
  {
    "sentence_id": "hb-c11-u0192-s001",
    "text": "I Finland är det viktigt att spara energi.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0192-s001.wav",
