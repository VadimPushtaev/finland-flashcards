    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0195-s003",
    "text": "Människans verksamhet orsakar förändringar i den naturliga miljön; förstöring, förorening, nedskräpning och övergödning samt utrotning av arter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0195-s003.wav",
