    "generation_seconds": 24.74586459901184,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0195-s004",
    "text": "Miljöskyddslagen förebygger förstöring av natur och miljö och motverkar miljöskador.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
