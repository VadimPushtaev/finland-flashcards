    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0192-s002",
    "text": "Genom att spara energi och vatten sparar man pengar, eftersom el- och vattenräkningarna blir lägre.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0192-s002.wav",
