    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0192-s004",
    "text": "Tanken är att alla människor ska använda el, energi och vatten sparsamt hemma.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-miljo/narration/hb-c11-u0192-s004.wav",
