    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0293-s002",
    "text": "Täta hus tål inte fukt, utan den kan snabbt orsaka problem i väggar och golv.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
