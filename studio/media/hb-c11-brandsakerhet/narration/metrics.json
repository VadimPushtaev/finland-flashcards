    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0289-s001",
    "text": "Om du har ett säkerhetslås i ditt hem, lås det alltid då du inte är hemma.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
