    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0293-s006",
    "text": "Ventilerna får inte stängas, utan måste hållas öppna och rena året om.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-brandsakerhet/narration/hb-c11-u0293-s006.wav",
