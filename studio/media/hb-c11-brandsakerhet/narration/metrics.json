    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0293-s003",
    "text": "Därför får man inte använda så mycket vatten när man städar golv och väggar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-brandsakerhet/narration/hb-c11-u0293-s003.wav",
