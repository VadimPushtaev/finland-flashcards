    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0293-s001",
    "text": "I Finland är husen täta för att det ska vara varmt inne på vintern.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-brandsakerhet/narration/hb-c11-u0293-s001.wav",
