    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c11-u0287-s003",
    "text": "Om du bor i villa, kontakta en jourhavande rörfirma.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c11-brandsakerhet/narration/hb-c11-u0287-s003.wav",
