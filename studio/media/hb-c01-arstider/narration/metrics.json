    "generation_seconds": 26.904868167010136
  },
  {
    "sentence_id": "hb-c01-u0036-s001",
    "text": "Ett av särdragen i klimatet i Finland jämfört med många andra länder är vintern.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0036-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.244625850340136,
    "peak": 0.279693603515625,
    "generation_seconds": 27.43786333297612
  },
  {
    "sentence_id": "hb-c01-u0036-s002",
    "text": "Man kan behöva vänja sig vid kylan, mörkret och halkan som kännetecknar den finska vintern.",
