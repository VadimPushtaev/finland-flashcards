  },
  {
    "sentence_id": "hb-c01-u0029-s002",
    "text": "Klimatet varierar mycket i de olika delarna av landet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0029-s002.wav",
