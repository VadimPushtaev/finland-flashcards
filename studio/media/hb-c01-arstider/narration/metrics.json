    "generation_seconds": 24.110651459021028
  },
  {
    "sentence_id": "hb-c01-u0035-s005",
    "text": "Trädens löv och växterna vissnar så småningom bort.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0035-s005.wav",
