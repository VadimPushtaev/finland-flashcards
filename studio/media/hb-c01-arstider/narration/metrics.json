    "generation_seconds": 43.41343579196837
  },
  {
    "sentence_id": "hb-c01-u0031-s002",
    "text": "Temperaturerna stiger och nederbörden ökar, men å andra sidan blir perioderna med torka också fler.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0031-s002.wav",
    "sample_rate": 44100,
    "seconds": 8.6378231292517,
    "peak": 0.36956787109375,
    "generation_seconds": 31.70730570802698
  },
  {
    "sentence_id": "hb-c01-u0031-s003",
    "text": "Perioderna med snö blir kortare särskilt i söder.",
    "engine": "supertonic",
    "voice": "F1",
