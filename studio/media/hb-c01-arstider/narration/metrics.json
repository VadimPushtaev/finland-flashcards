    "generation_seconds": 27.46873116597999
  },
  {
    "sentence_id": "hb-c01-u0035-s001",
    "text": "Hösten varar omkring två månader i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0035-s001.wav",
    "sample_rate": 44100,
