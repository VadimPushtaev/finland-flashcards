    "generation_seconds": 22.424540167034138
  },
  {
    "sentence_id": "hb-c01-u0034-s002",
    "text": "Sommarmånaderna är juni, juli och augusti.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0034-s002.wav",
    "sample_rate": 44100,
    "seconds": 4.179591836734694,
    "peak": 0.216339111328125,
    "generation_seconds": 11.482717374979984
  },
  {
    "sentence_id": "hb-c01-u0034-s007",
    "text": "Den finska sommaren är ibland het och temperaturen stiger över plus tjugofem grader Celsius.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0034-s007.wav",
    "sample_rate": 44100,
    "seconds": 7.87156462585034,
    "peak": 0.28173828125,
    "generation_seconds": 27.770333749998827
  },
  {
    "sentence_id": "hb-c01-u0034-s008",
    "text": "Ibland kan sommaren vara sval och regnig.",
