    "generation_seconds": 14.271097374963574
  },
  {
    "sentence_id": "hb-c01-u0034-s006",
    "text": "På sommaren vistas människorna mycket utomhus och njuter av ljuset och värmen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0034-s006.wav",
    "sample_rate": 44100,
    "seconds": 6.965986394557823,
