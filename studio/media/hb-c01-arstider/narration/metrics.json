  },
  {
    "sentence_id": "hb-c01-u0035-s003",
    "text": "I norr börjar hösten redan i slutet av augusti och slutar i mitten av oktober.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0035-s003.wav",
    "sample_rate": 44100,
    "seconds": 7.314285714285714,
    "peak": 0.238555908203125,
    "generation_seconds": 27.990031540975906
  },
  {
    "sentence_id": "hb-c01-u0035-s004",
    "text": "Under hösten blir vädret kallare och den ljusa delen av dygnet blir kortare.",
