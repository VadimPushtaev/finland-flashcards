    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0034-s008.wav",
    "sample_rate": 44100,
    "seconds": 4.040272108843538,
    "peak": 0.271148681640625,
    "generation_seconds": 13.440860542003065
  },
  {
    "sentence_id": "hb-c01-u0034-s004",
    "text": "I Lappland skiner solen dygnet runt på sommaren, också på natten.",
