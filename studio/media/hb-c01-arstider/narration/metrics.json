    "generation_seconds": 24.072775541979354
  },
  {
    "sentence_id": "hb-c01-u0034-s005",
    "text": "Fenomenet kallas midnattssol.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0034-s005.wav",
    "sample_rate": 44100,
    "seconds": 3.0650340136054424,
