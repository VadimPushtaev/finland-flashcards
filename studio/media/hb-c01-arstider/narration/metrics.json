    "generation_seconds": 38.761356583971065
  },
  {
    "sentence_id": "hb-c01-u0032-s001",
    "text": "I norra Finland kan vintern vara kall och mycket snörik.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0032-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.154829931972789,
    "peak": 0.355926513671875,
    "generation_seconds": 29.753118583001196
  },
  {
    "sentence_id": "hb-c01-u0032-s008",
    "text": "Temperaturen kan ibland vara till och med minus trettio grader Celsius.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0032-s008.wav",
    "sample_rate": 44100,
    "seconds": 6.2693877551020405,
    "peak": 0.26898193359375,
    "generation_seconds": 36.988604000012856
  },
  {
    "sentence_id": "hb-c01-u0032-s009",
    "text": "I Södra Finland är det sällan så kallt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0032-s009.wav",
    "sample_rate": 44100,
    "seconds": 3.900952380952381,
    "peak": 0.319366455078125,
    "generation_seconds": 19.27399824996246
  },
  {
    "sentence_id": "hb-c01-u0032-s003",
    "text": "Till exempel i Helsingfors ligger temperaturen i januari mellan noll grader Celsius och minus tio grader Celsius den största delen av tiden.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0032-s003.wav",
    "sample_rate": 44100,
    "seconds": 11.702857142857143,
    "peak": 0.265655517578125,
    "generation_seconds": 44.107373459031805
  },
  {
    "sentence_id": "hb-c01-u0032-s004",
    "text": "Hur lång vintern är varierar i olika delar av landet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0032-s004.wav",
    "sample_rate": 44100,
    "seconds": 5.015510204081632,
    "peak": 0.311767578125,
    "generation_seconds": 35.30847733299015
  },
  {
    "sentence_id": "hb-c01-u0032-s005",
    "text": "I den norra delen av Finland, det vill säga Lappland, varar vintern ett halvår, medan Södra Finland har vinter en tredjedel av året, i allmänhet från slutet av november till slutet av mars.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0032-s005.wav",
    "sample_rate": 44100,
    "seconds": 16.16108843537415,
    "peak": 0.416107177734375,
    "generation_seconds": 87.52570566703798
  },
  {
    "sentence_id": "hb-c01-u0032-s006",
    "text": "Den ljusa tiden av dygnet är kort på vintern, kortare i norr än i söder.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0032-s006.wav",
    "sample_rate": 44100,
    "seconds": 6.478367346938776,
    "peak": 0.242523193359375,
    "generation_seconds": 23.32655870896997
  },
  {
    "sentence_id": "hb-c01-u0032-s007",
    "text": "På vintern utövar många gärna vintersporter, såsom skridskoåkning, längdåkning och utförsåkning.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0032-s007.wav",
    "sample_rate": 44100,
    "seconds": 8.219863945578231,
    "peak": 0.275665283203125,
    "generation_seconds": 24.230358625005465
  },
  {
    "sentence_id": "hb-c01-u0033-s001",
    "text": "Våren är den kortaste av årstiderna i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0033-s001.wav",
    "sample_rate": 44100,
    "seconds": 4.667210884353741,
    "peak": 0.2694091796875,
    "generation_seconds": 14.698334292043
  },
  {
    "sentence_id": "hb-c01-u0033-s002",
    "text": "Den varar endast en och en halv till två månader och infaller i april till maj.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0033-s002.wav",
    "sample_rate": 44100,
    "seconds": 6.826666666666667,
    "peak": 0.2587890625,
    "generation_seconds": 21.135675041005015
  },
  {
    "sentence_id": "hb-c01-u0033-s003",
    "text": "På våren smälter snön och isen, och den ljusa delen av dygnet blir längre.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0033-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.408707482993197,
    "peak": 0.264129638671875,
    "generation_seconds": 20.102814334037248
  },
  {
    "sentence_id": "hb-c01-u0033-s004",
    "text": "Samtidigt börjar en ny växtsäsong.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0033-s004.wav",
    "sample_rate": 44100,
    "seconds": 3.5526530612244898,
    "peak": 0.368133544921875,
    "generation_seconds": 11.66485904197907
  },
  {
    "sentence_id": "hb-c01-u0033-s005",
    "text": "I Finland har växterna bara en växtsäsong, från våren till hösten.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0033-s005.wav",
    "sample_rate": 44100,
    "seconds": 6.130068027210885,
    "peak": 0.35888671875,
    "generation_seconds": 18.62560033396585
  },
  {
    "sentence_id": "hb-c01-u0033-s006",
    "text": "Människorna följer ofta ivrigt med hur våren framskrider, till exempel när vissa flyttfåglar återvänder till landet eller de första blommorna visar sig.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c01-arstider/narration/hb-c01-u0033-s006.wav",
    "sample_rate": 44100,
    "seconds": 13.02639455782313,
    "peak": 0.33648681640625,
    "generation_seconds": 21.924533832992893
  },
  {
    "sentence_id": "hb-c01-u0034-s001",
    "text": "Sommaren är en varm årstid, som varar i omkring två månader i norr och omkring fyra månader i söder.",
