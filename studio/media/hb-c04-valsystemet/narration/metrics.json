    "generation_seconds": 38.26875116804149,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0087-s002",
    "text": "Det innebär att i varje valkrets blir det antal kandidater från varje parti valt som motsvarar partiets andel av alla avgivna röster i valkretsen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-valsystemet/narration/hb-c04-u0087-s002.wav",
