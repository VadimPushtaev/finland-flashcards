    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0089-s002",
    "text": "Väljarna kan alltså påverka både vilka partier som får flest representantplatser i valet och vilka av partiets kandidater som blir valda.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
