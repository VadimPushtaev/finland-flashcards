    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0087-s004",
    "text": "I riksdagsval är valkretsarna stora, och från varje valkrets väljs flera representanter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-valsystemet/narration/hb-c04-u0087-s004.wav",
