    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0091-s002",
    "text": "Det är viktigt men frivilligt att rösta.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-valsystemet/narration/hb-c04-u0091-s002.wav",
