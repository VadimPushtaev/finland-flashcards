    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0089-s001",
    "text": "Utifrån väljarnas röster bestäms också vilka av partiets kandidater som sist och slutligen blir valda.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
