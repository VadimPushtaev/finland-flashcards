    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0088-s002",
    "text": "Partiets alla kandidater drar nytta av den avgivna rösten, även om just den egna kandidaten inte skulle bli vald.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
