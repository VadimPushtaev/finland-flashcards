    "generation_seconds": 31.467556522984523,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0087-s005",
    "text": "Vid välfärdsområdesval utgörs valkretsen av välfärdsområdet och vid kommunalval av kommunen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-valsystemet/narration/hb-c04-u0087-s005.wav",
