  {
    "sentence_id": "hb-c04-u0087-s001",
    "text": "I Finland tillämpas ett proportionellt valsätt vid riksdagsval, välfärdsområdes- och kommunalval och Europaparlamentsval.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-valsystemet/narration/hb-c04-u0087-s001.wav",
