    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0087-s006",
    "text": "Vid Europaparlamentsval utgör hela landet valkretsen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-valsystemet/narration/hb-c04-u0087-s006.wav",
