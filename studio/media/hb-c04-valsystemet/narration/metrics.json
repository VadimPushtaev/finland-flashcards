    "generation_seconds": 25.1556857029791,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0088-s001",
    "text": "När man röstar på en kandidat för ett parti, går rösten i första hand till partiet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-valsystemet/narration/hb-c04-u0088-s001.wav",
