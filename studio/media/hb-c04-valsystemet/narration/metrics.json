    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0087-s003",
    "text": "Om ett parti med andra ord får 20 procent av de avgivna rösterna, får det i stort sett 20 procent av platserna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-valsystemet/narration/hb-c04-u0087-s003.wav",
