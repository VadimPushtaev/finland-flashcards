    "intra_op_num_threads": 1
  },
  {
    "sentence_id": "hb-c06-u0098-s005",
    "text": "I sådana fall är det i allmänhet en nämndemannasammansättning bestående av en yrkesdomare och två nämndemän som beslutar om domen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
