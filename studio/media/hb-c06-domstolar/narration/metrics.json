    "intra_op_num_threads": 1
  },
  {
    "sentence_id": "hb-c06-u0098-s001",
    "text": "I rätten bedömer domarna om bevisen i fallen är tillförlitliga.",
    "engine": "supertonic",
    "voice": "F1",
