    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0136-s001",
    "text": "Med arbetstid avses den tid som används på arbetet och som arbetstagaren ska befinna sig på arbetsplatsen eller finnas tillgänglig för arbetsgivarens förfogande.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
