    "generation_seconds": 43.34910190093797,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0135-s001",
    "text": "Arbetsgivaren ansvarar för att anmäla korrekta uppgifter till inkomstregistret.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0135-s001.wav",
