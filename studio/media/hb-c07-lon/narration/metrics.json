    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0139-s001",
    "text": "I vissa yrken, till exempel i restaurangbranschen, transportbranschen och på vårdinrättningar, kan den ordinarie arbetstiden ordnas som periodiskt arbete.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
