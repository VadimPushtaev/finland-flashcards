    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0131-s002",
    "text": "I vissa branscher betalas ackordslön (urakkapalkka), som baserar sig på prestationen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
