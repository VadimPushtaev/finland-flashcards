    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0127-s002",
    "text": "Tilläggens storlek beror på yrket och kollektivavtalet för branschen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0127-s002.wav",
    "sample_rate": 44100,
