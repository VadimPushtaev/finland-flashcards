    "generation_seconds": 25.5819952939637,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0139-s002",
    "text": "I detta fall är den ordinarie arbetstiden antingen åttio timmar under en tvåveckorsperiod eller hundratjugo timmar under en treveckorsperiod.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
