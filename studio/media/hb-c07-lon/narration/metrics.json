    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0133-s002",
    "text": "Du ska kontrollera att uppgifterna i lönespecifikationen är korrekta.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0133-s002.wav",
