    "generation_seconds": 21.313586671021767,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0134-s003",
    "text": "Förutom Skatteförvaltningen är dessa Migrationsverket (Maahanmuuttovirasto), FPA (Kela), Pensionsskyddscentralen (Eläketurvakeskus), arbetslöshetskassorna och andra myndigheter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0134-s003.wav",
