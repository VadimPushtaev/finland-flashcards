  },
  {
    "sentence_id": "hb-c07-u0143-s001",
    "text": "Observera att om arbetsgivaren slutar att erbjuda dig arbete helt och hållet, har du rätt att få en skriftlig förklaring av arbetsgivaren om varför arbetsmängden har minskat.",
    "engine": "supertonic",
    "voice": "F1",
