    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0134-s002",
    "text": "Uppgifterna i tulorekisteri används av många organisationer och myndigheter som har rätt att göra det.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0134-s002.wav",
