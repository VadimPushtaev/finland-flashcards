    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0132-s001",
    "text": "Arbetsgivaren ska betala in lönen på ditt bankkonto den dag som överenskommits i arbetsavtalet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
