    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0133-s003",
    "text": "Skriv upp dina arbetstimmar så är det lättare att kontrollera lönespecifikationen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0133-s003.wav",
