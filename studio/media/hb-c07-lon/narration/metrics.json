    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0139-s003",
    "text": "Kontrollera arbetstiden i kollektivavtalet för din bransch.",
    "engine": "supertonic",
    "voice": "F1",
