    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0135-s004",
    "text": "Du kan fråga skattemyndigheterna om mer information.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0135-s004.wav",
