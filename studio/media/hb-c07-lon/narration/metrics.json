    "seconds": 9.264761904761905,
    "peak": 0.410369873046875,
    "generation_seconds": 23.90514112089295,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0137-s001",
    "text": "Arbetsgivaren måste bokföra dina arbetstimmar.",
    "engine": "supertonic",
    "voice": "F1",
