    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0131-s001",
    "text": "Lönen för arbetet kan betalas som timlön, veckolön eller månadslön.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
