    "seconds": 5.990748299319728,
    "peak": 0.269622802734375,
    "generation_seconds": 19.966422421042807,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0127-s004",
    "text": "Om en anställd på arbetsgivarens order arbetar övertid utöver den normala arbetstiden, måste extra lön betalas också för det.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0127-s004.wav",
