    "seconds": 7.174965986394557,
    "peak": 0.354522705078125,
    "generation_seconds": 17.57228862599004,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0135-s002",
    "text": "När löneuppgifterna är korrekt anmälda borde du se samma belopp på ditt konto och i inkomstregistret.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0135-s002.wav",
    "sample_rate": 44100,
    "seconds": 8.777142857142858,
    "peak": 0.391937255859375,
    "generation_seconds": 23.36787459696643,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0135-s003",
    "text": "Om det finns fel i uppgifterna ska du be arbetsgivaren att korrigera uppgifterna i inkomstregistret.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0135-s003.wav",
