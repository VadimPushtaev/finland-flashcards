    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0132-s003",
    "text": "Om utbetalningsdagen infaller på veckoslutet eller en helgdag ska lönen betalas den föregående vardagen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
