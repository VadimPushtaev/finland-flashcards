    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0134-s001",
    "text": "Tulorekisteri är en databas dit arbetsgivarna anmäler lönerna som de betalat till sina anställda.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0134-s001.wav",
