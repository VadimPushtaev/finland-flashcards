  },
  {
    "sentence_id": "hb-c07-u0141-s001",
    "text": "I skiftarbete (vuorotyö) varierar arbetsskiften så att du till exempel kan arbeta i morgonskift, kvällsskift eller nattskift.",
    "engine": "supertonic",
    "voice": "F1",
