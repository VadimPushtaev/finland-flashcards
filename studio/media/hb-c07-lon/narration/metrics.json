    "generation_seconds": 28.929321433999576,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0129-s001",
    "text": "Om branschen inte har ett kollektivavtal kan arbetsgivaren och arbetstagaren komma överens om lönen sinsemellan.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0129-s001.wav",
    "sample_rate": 44100,
    "seconds": 9.822040816326531,
    "peak": 0.36065673828125,
    "generation_seconds": 31.346790389041416,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0129-s002",
    "text": "Enligt lagen ska lönen vara sedvanlig och skälig, med andra ord ska du få samma lön som andra som utför samma eller liknande arbete.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0129-s002.wav",
    "sample_rate": 44100,
    "seconds": 11.075918367346938,
    "peak": 0.337310791015625,
    "generation_seconds": 31.866212405031547,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0130-s001",
    "text": "Om du har en prövotid ska normal lön betalas under denna period.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0130-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.921088435374149,
    "peak": 0.243133544921875,
    "generation_seconds": 18.371165369055234,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0130-s002",
    "text": "Att arbeta utan lön är lagligt endast i sysselsättningstjänsternas arbetsprövning, i volontärarbete eller under en praktik som ingår i studierna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0130-s002.wav",
