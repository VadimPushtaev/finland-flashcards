    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0127-s001",
    "text": "Om en anställd arbetar på kvällar, helger eller högtider får hen utöver den vanliga lönen också tillägg.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0127-s001.wav",
