    "generation_seconds": 20.452992597944103,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0127-s003",
    "text": "För söndagsarbete måste man betala dubbel lön inom alla branscher.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0127-s003.wav",
