    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0136-s002",
    "text": "I Finland regleras arbetstiden av arbetstidslagen (työaikalaki) och kollektivavtalen (työehtosopimus).",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0136-s002.wav",
