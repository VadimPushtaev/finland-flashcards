  },
  {
    "sentence_id": "hb-c07-u0138-s002",
    "text": "Enligt lag får den ordinarie arbetstiden (säännöllinen työaika) vara högst åtta timmar per dygn och fyrtio timmar per vecka.",
    "engine": "supertonic",
    "voice": "F1",
