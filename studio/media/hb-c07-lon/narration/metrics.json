    "generation_seconds": 35.40922602196224,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0127-s005",
    "text": "I kollektivavtalet för den egna branschen finns information om hurdana tillägg som ska betalas till arbetstagarna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0127-s005.wav",
    "sample_rate": 44100,
    "seconds": 9.961360544217687,
    "peak": 0.34234619140625,
    "generation_seconds": 28.292301536072046,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0128-s001",
    "text": "Arbetsgivaren måste ge den anställda en lönespecifikation.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0128-s001.wav",
