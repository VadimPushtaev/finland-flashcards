    "seconds": 5.363809523809524,
    "peak": 0.32354736328125,
    "generation_seconds": 17.36518533702474,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0128-s002",
    "text": "I den ser den anställda alla skatter och övriga avgifter som dragits av på lönen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0128-s002.wav",
    "sample_rate": 44100,
    "seconds": 7.453605442176871,
    "peak": 0.4923095703125,
    "generation_seconds": 22.068490203935653,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0128-s003",
    "text": "I specifikationen kan man också kontrollera att lönen och tilläggen har betalats ut korrekt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0128-s003.wav",
    "sample_rate": 44100,
    "seconds": 7.801904761904762,
    "peak": 0.33349609375,
    "generation_seconds": 19.982791436021216,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0128-s004",
    "text": "Om det finns ett fel i lönebetalningen och det har betalats för lite lön, ska man be att det korrigeras.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0128-s004.wav",
    "sample_rate": 44100,
    "seconds": 8.6378231292517,
    "peak": 0.2530517578125,
    "generation_seconds": 26.946360787027515,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0128-s005",
    "text": "Om man av misstag har fått för mycket lön är den anställda skyldig att betala tillbaka den del som överstiger den normala lönen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-lon/narration/hb-c07-u0128-s005.wav",
    "sample_rate": 44100,
