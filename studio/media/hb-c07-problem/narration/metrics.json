    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0201-s004",
    "text": "Den som utför svartarbete blir utan inkomstrelaterad arbetslöshetsdagpenning och graviditetspenning och föräldrapenning, och tjänar inte in någon pension för ålderdomen eller i händelse av arbetsoförmåga.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0201-s004.wav",
