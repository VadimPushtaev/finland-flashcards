    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0202-s002",
    "text": "Om det uppstår en tvist med arbetsgivaren om till exempel lönen, är det svårt att få hjälp.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0202-s002.wav",
    "sample_rate": 44100,
