    "generation_seconds": 22.820149517967366,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0203-s001",
    "text": "I värsta fall kan utnyttjande av en arbetstagare vara människohandel.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0203-s001.wav",
    "sample_rate": 44100,
    "seconds": 6.408707482993197,
    "peak": 0.377166748046875,
