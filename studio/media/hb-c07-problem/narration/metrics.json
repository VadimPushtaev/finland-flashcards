    "peak": 0.309326171875,
    "generation_seconds": 14.628466947935522,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0205-s001",
    "text": "Arbetsgivaren beslagtar arbetstagarens bankkort, pass, uppehållstillstånd eller andra viktiga handlingar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0205-s001.wav",
    "sample_rate": 44100,
    "seconds": 9.334421768707482,
    "peak": 0.477294921875,
    "generation_seconds": 21.957325882045552,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0207-s001",
    "text": "Arbetstagaren är tvungen att övernatta på arbetsplatsen under eländiga förhållanden.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0207-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.453605442176871,
    "peak": 0.38958740234375,
    "generation_seconds": 16.672662477009,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0208-s001",
    "text": "Arbetsgivaren är våldsam mot eller hotar arbetstagaren med våld.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0208-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.851428571428571,
    "peak": 0.32781982421875,
    "generation_seconds": 14.336967497947626,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0209-s001",
    "text": "Människohandel är ofta förknippad med att en arbetstagare är verkligt bunden till arbetsgivaren.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0209-s001.wav",
    "sample_rate": 44100,
    "seconds": 8.568163265306122,
    "peak": 0.399139404296875,
    "generation_seconds": 18.737232354003936,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0209-s002",
    "text": "Arbetstagaren kan stå i skuld till arbetsgivaren eller så har arbetsgivaren beslagtagit den anställdas handlingar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0209-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.822040816326531,
    "peak": 0.358734130859375,
    "generation_seconds": 17.299816809012555,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0209-s003",
    "text": "Det är i praktiken omöjligt för den anställda att vägra utföra arbetet eller sluta att arbeta för arbetsgivaren.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0209-s003.wav",
    "sample_rate": 44100,
    "seconds": 9.682721088435374,
    "peak": 0.437286376953125,
    "generation_seconds": 17.076735503971577,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0209-s004",
    "text": "Dessutom kan det hända att arbetsgivaren använder våld eller hotar att skada arbetstagaren eller hens närstående.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0209-s004.wav",
