    "seconds": 13.305034013605443,
    "peak": 0.35150146484375,
    "generation_seconds": 26.35659365495667,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0213-s004",
    "text": "Man kan få rådgivning per telefon och e-post.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0213-s004.wav",
    "sample_rate": 44100,
