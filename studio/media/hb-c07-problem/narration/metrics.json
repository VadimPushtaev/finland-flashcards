    "seconds": 9.682721088435374,
    "peak": 0.40887451171875,
    "generation_seconds": 18.17094327195082,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0210-s001",
    "text": "Det är bra om den anställda först pratar direkt med chefen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0210-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.294149659863946,
    "peak": 0.291229248046875,
    "generation_seconds": 9.290459720999934,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0210-s002",
    "text": "Hen kan också be förtroendemannen eller arbetarskyddsfullmäktigen om hjälp om en sådan finns på arbetsplatsen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0210-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.682721088435374,
    "peak": 0.269927978515625,
    "generation_seconds": 17.275548563920893,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0211-s001",
    "text": "Ibland kan man inte vända sig till chefen, eftersom hen är delaktig i den dåliga behandlingen av den anställda.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
