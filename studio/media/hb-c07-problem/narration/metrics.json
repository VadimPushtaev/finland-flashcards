    "peak": 0.305084228515625,
    "generation_seconds": 14.63750154292211,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0215-s001",
    "text": "I Finland finns dessutom Hjälpsystemet för offer för människohandel, som är en myndighet som lyder under Migrationsverket.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0215-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.588299319727891,
    "peak": 0.293243408203125,
    "generation_seconds": 21.136393444030546,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0215-s002",
    "text": "Personer som antagits i hjälpsystemet kan genom systemet vid behov få bland annat ett tryggt boende, handledning och rådgivning eller ett rättsbiträde.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0215-s002.wav",
    "sample_rate": 44100,
    "seconds": 12.329795918367347,
    "peak": 0.379730224609375,
    "generation_seconds": 25.89687546901405,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0216-s001",
    "text": "Om du har fått för lite lön, ska du be din arbetsgivare att rätta till löneutbetalningen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0216-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.732244897959184,
    "peak": 0.2679443359375,
    "generation_seconds": 16.619204416987486,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0216-s002",
    "text": "Om arbetsgivaren inte betalar ut din lön korrekt, trots att du ber om det, kan du kontakta ditt fackförbund.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0216-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.404081632653062,
    "peak": 0.35516357421875,
    "generation_seconds": 17.25322551210411,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0216-s003",
    "text": "Om du inte är med i ett fackförbund kan du be om hjälp från personalrepresentanterna på din arbetsplats eller rättshjälpsbyrån.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0216-s003.wav",
    "sample_rate": 44100,
    "seconds": 11.284897959183674,
    "peak": 0.372406005859375,
    "generation_seconds": 20.22520823602099,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0217-s001",
    "text": "Om arbetsgivaren inte kan betala ut din lön, ska du omgående kontakta Lönegarantin.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0217-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.523265306122449,
    "peak": 0.327056884765625,
    "generation_seconds": 13.246822274057195,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0217-s002",
    "text": "Om arbetsgivaren inte har pengar kan du få betalt där.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0217-s002.wav",
    "sample_rate": 44100,
    "seconds": 5.085170068027211,
    "peak": 0.3365478515625,
    "generation_seconds": 12.927066080039367,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0217-s003",
    "text": "Gör ansökan inom tre månader från det att lönen skulle ha betalats.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
