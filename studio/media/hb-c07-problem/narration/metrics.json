    "peak": 0.363128662109375,
    "generation_seconds": 15.729885906912386,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0211-s002",
    "text": "Om situationen inte kan lösas på arbetsplatsen eller om det är fråga om allvarligare problem, är det värt att berätta om den dåliga behandlingen för en utomstående, till exempel en myndighet eller Brottsofferjouren.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0211-s002.wav",
    "sample_rate": 44100,
    "seconds": 17.76326530612245,
    "peak": 0.351287841796875,
    "generation_seconds": 32.930092697031796,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0212-s001",
    "text": "Arbetarskyddsmyndigheten ger både arbetstagare och arbetsgivare rådgivning.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0212-s001.wav",
    "sample_rate": 44100,
    "seconds": 6.617687074829932,
    "peak": 0.436004638671875,
    "generation_seconds": 12.212788129108958,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0212-s002",
    "text": "Den övervakar att arbetsgivarna följer de lagar som gäller arbetslivet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0212-s002.wav",
    "sample_rate": 44100,
    "seconds": 6.408707482993197,
    "peak": 0.366455078125,
    "generation_seconds": 13.43683557503391,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0212-s003",
    "text": "Vid diskriminering kan man kontakta förutom arbetarskyddsmyndigheten också diskrimineringsombudsmannen eller jämställdhetsombudsmannen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0212-s003.wav",
    "sample_rate": 44100,
    "seconds": 11.702857142857143,
    "peak": 0.386688232421875,
    "generation_seconds": 22.80604751606006,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0213-s001",
    "text": "Också fackförbundet erbjuder hjälp om den anställda är medlem i ett sådant.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0213-s001.wav",
    "sample_rate": 44100,
    "seconds": 6.6873469387755105,
    "peak": 0.3594970703125,
    "generation_seconds": 13.023986691026948,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0213-s002",
    "text": "Fackförbunden främjar arbetstagarnas rättigheter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0213-s002.wav",
    "sample_rate": 44100,
    "seconds": 4.73687074829932,
    "peak": 0.409088134765625,
    "generation_seconds": 11.007548445020802,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0213-s003",
    "text": "Finlands Fackförbunds Centralorganisation F F C erbjuder dessutom gratis anställningsrådgivning, även om man inte är medlem i något fackförbund.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0213-s003.wav",
