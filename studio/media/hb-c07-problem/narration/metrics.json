    "peak": 0.2889404296875,
    "generation_seconds": 8.502671516966075,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0214-s001",
    "text": "Människohandel är en polisfråga i Finland, men man kan till en början söka hjälp också hos till exempel arbetarskyddsmyndigheterna eller Brottsofferjouren.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0214-s001.wav",
    "sample_rate": 44100,
    "seconds": 13.444353741496599,
    "peak": 0.522491455078125,
    "generation_seconds": 25.36236932897009,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0214-s002",
    "text": "Brottsofferjouren är en organisation som ger brottsoffer rådgivning och stöd.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0214-s002.wav",
    "sample_rate": 44100,
