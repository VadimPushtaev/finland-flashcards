    "peak": 0.2816162109375,
    "generation_seconds": 22.589672845089808,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0202-s003",
    "text": "Om det sker en olycka på arbetsplatsen kan den anställda inte få någon försäkringsersättning.",
