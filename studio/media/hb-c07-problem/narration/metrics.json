    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0203-s002",
    "text": "Med människohandel avses en situation där en arbetstagare är tvungen att arbeta under förhållanden som påminner om tvångsarbete.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0203-s002.wav",
    "sample_rate": 44100,
    "seconds": 11.145578231292516,
    "peak": 0.344757080078125,
    "generation_seconds": 24.982155653997324,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0204-s001",
    "text": "Människohandel kännetecknas av bland annat följande:",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-problem/narration/hb-c07-u0204-s001.wav",
