    "generation_seconds": 43.55835340300109,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c05-u0061-s001",
    "text": "Du har rätt till samma lagstadgade anställningsvillkor som en finsk arbetstagare.",
    "engine": "supertonic",
    "voice": "F1",
