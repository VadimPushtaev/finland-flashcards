  },
  {
    "sentence_id": "hb-c06-u0111-s002",
    "text": "Andra vanliga straff i Finland är fängelse, samhällstjänst och övervakningsstraff.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
