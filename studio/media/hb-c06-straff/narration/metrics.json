    "intra_op_num_threads": 1
  },
  {
    "sentence_id": "hb-c06-u0111-s001",
    "text": "Om brottet inte är särskilt allvarligt, kan straffet vara böter, som betalas till staten.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
