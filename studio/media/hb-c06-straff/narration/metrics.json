  {
    "sentence_id": "hb-c06-u0110-s002",
    "text": "I Finland får bara den som begått brottet ett straff, inte förbrytarens familj.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
