    "intra_op_num_threads": 1
  },
  {
    "sentence_id": "hb-c06-u0111-s003",
    "text": "Ett fängelsestraff kan vara ovillkorligt, varvid straffet avtjänas i fängelse, eller villkorligt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
