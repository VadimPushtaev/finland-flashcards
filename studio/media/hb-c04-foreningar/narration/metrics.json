    "generation_seconds": 72.18786966899643,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0200-s002",
    "text": "Dessa föreningar kan vara bra ställen för kamratstöd från andra människor som flyttat till landet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
