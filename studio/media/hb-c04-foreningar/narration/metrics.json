    "seconds": 8.846802721088435,
    "peak": 0.274017333984375,
    "generation_seconds": 36.15053904801607,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0201-s003",
    "text": "En registrerad förening kan ansöka om finansiering och bidrag samt samarbeta med andra föreningar och myndigheter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-foreningar/narration/hb-c04-u0201-s003.wav",
