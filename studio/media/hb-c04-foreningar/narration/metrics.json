    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0201-s002",
    "text": "Då är föreningen en juridisk person vars medlemmar inte personligen bär ansvar för föreningens verksamhet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-foreningar/narration/hb-c04-u0201-s002.wav",
