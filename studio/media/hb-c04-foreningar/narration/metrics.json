    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0202-s001",
    "text": "Också utlänningar, det vill säga personer som inte har finskt medborgarskap, kan grunda en registrerad förening.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-foreningar/narration/hb-c04-u0202-s001.wav",
