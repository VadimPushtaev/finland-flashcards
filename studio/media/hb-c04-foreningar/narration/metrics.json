    "generation_seconds": 42.552190669986885,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0200-s003",
    "text": "I dem kan man till exempel fira högtider som hör till den egna kulturen tillsammans med andra.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
