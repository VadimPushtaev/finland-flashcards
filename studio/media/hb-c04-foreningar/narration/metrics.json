    "generation_seconds": 38.44198557600612,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0201-s001",
    "text": "Det lönar sig att registrera sin förening.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-foreningar/narration/hb-c04-u0201-s001.wav",
