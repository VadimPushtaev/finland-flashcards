    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0202-s002",
    "text": "I detta fall ska både ordföranden och vice ordföranden ha sin hemort i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-foreningar/narration/hb-c04-u0202-s002.wav",
