    "generation_seconds": 46.19997213699389,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c04-u0201-s004",
    "text": "Föreningen registreras med anmälan till Patent- och registerstyrelsen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-foreningar/narration/hb-c04-u0201-s004.wav",
