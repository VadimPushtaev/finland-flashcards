  },
  {
    "sentence_id": "hb-c09-u0092-s002",
    "text": "Dessutom ska minst två vittnen som har fyllt 15 år vara på plats.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c09-aktenskap/narration/hb-c09-u0092-s002.wav",
