  },
  {
    "sentence_id": "hb-c09-u0093-s001",
    "text": "Alla har rätt till borgerlig vigsel, även de som tillhör ett trossamfund.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
