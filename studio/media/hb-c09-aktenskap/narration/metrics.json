    "generation_seconds": 10.562701820163056,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c09-u0092-s001",
    "text": "Båda makarna måste vara på plats vid vigseltillfället.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c09-aktenskap/narration/hb-c09-u0092-s001.wav",
