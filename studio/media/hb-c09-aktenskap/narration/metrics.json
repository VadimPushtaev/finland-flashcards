    "generation_seconds": 10.466172160115093,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c09-u0090-s001",
    "text": "En borgerlig vigsel kan ske antingen på ett verksamhetsställe för Myndigheten för digitalisering och befolkningsdata eller i en tingsrätt.",
    "engine": "supertonic",
    "voice": "F1",
