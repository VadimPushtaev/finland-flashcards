    "generation_seconds": 17.510651652002707,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c09-u0091-s004",
    "text": "Dessutom måste en prövning av hinder för äktenskapet ha gjorts före vigseln.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c09-aktenskap/narration/hb-c09-u0091-s004.wav",
