    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c09-u0091-s001",
    "text": "En kyrklig vigsel kan förrättas av en präst inom den evangelisk-lutherska eller den ortodoxa kyrkan.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
