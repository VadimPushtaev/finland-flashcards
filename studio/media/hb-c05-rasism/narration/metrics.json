    "intra_op_num_threads": 1
  },
  {
    "sentence_id": "hb-c05-u0070-s002",
    "text": "Den kan förekomma till exempel i arbetslivet och inom utbildning och tjänster.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
