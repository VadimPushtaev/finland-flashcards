    "generation_seconds": 63.35400216199923,
    "intra_op_num_threads": 1
  },
  {
    "sentence_id": "hb-c05-u0069-s003",
    "text": "Rasism definieras på olika sätt i olika sammanhang.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c05-rasism/narration/hb-c05-u0069-s003.wav",
