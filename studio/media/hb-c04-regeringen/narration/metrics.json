    "generation_seconds": 13.6275823879987
  },
  {
    "sentence_id": "hb-c04-u0034-s001",
    "text": "När regeringsprogrammet är färdigt utser riksdagen officiellt en statsminister genom omröstning.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
