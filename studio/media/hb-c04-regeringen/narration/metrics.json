    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-regeringen/narration/hb-c04-u0035-s002.wav",
    "sample_rate": 44100,
    "seconds": 6.757006802721088,
    "peak": 0.285858154296875,
    "generation_seconds": 11.16610520600807
  },
  {
    "sentence_id": "hb-c04-u0035-s003",
    "text": "Exempel på ministerier är försvarsministeriet, social- och hälsovårdsministeriet och inrikesministeriet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-regeringen/narration/hb-c04-u0035-s003.wav",
    "sample_rate": 44100,
    "seconds": 9.891700680272109,
    "peak": 0.23980712890625,
    "generation_seconds": 18.290035647980403
  },
  {
    "sentence_id": "hb-c04-u0035-s004",
    "text": "Flera statliga ämbetsverk och inrättningar lyder under och styrs av ministerierna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-regeringen/narration/hb-c04-u0035-s004.wav",
    "sample_rate": 44100,
    "seconds": 7.453605442176871,
    "peak": 0.2789306640625,
    "generation_seconds": 13.389794645016082
  },
  {
    "sentence_id": "hb-c04-u0035-s005",
    "text": "Till exempel Migrationsverket är ett ämbetsverk som lyder under inrikesministeriet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-regeringen/narration/hb-c04-u0035-s005.wav",
    "sample_rate": 44100,
    "seconds": 7.592925170068027,
