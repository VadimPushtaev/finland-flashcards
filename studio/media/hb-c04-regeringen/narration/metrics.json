    "generation_seconds": 17.348000265017617
  },
  {
    "sentence_id": "hb-c04-u0034-s004",
    "text": "Riksdagen godkänner ännu genom omröstning statsrådets sammansättning och regeringsprogrammet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-regeringen/narration/hb-c04-u0034-s004.wav",
    "sample_rate": 44100,
    "seconds": 8.150204081632653,
    "peak": 0.29644775390625,
    "generation_seconds": 19.25215166300768
  },
  {
    "sentence_id": "hb-c04-u0035-s001",
    "text": "Ministrarna leder ministeriernas arbete.",
