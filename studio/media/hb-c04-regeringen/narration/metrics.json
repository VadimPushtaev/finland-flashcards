    "generation_seconds": 13.185489897965454
  },
  {
    "sentence_id": "hb-c04-u0034-s003",
    "text": "När statsministern och övriga ministrar har utsetts utnämner presidenten dem för deras uppgifter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
