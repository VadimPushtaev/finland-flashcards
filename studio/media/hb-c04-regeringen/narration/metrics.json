    "generation_seconds": 14.844201004016213
  },
  {
    "sentence_id": "hb-c04-u0032-s004",
    "text": "Exempel på ministrar är inrikesminister, utrikesminister, undervisningsminister och justitieminister.",
    "engine": "supertonic",
    "voice": "F1",
