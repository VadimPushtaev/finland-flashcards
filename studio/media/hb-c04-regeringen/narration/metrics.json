    "generation_seconds": 13.424297768971883
  },
  {
    "sentence_id": "hb-c04-u0034-s002",
    "text": "Regeringspartierna beslutar om vem från respektive parti som ska bli minister.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
