    "generation_seconds": 11.222868508019019
  },
  {
    "sentence_id": "hb-c04-u0033-s003",
    "text": "I Finland är det vanligt att det finns flera partier i regeringen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-regeringen/narration/hb-c04-u0033-s003.wav",
