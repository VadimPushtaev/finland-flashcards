    "generation_seconds": 12.72520202898886
  },
  {
    "sentence_id": "hb-c04-u0033-s001",
    "text": "I allmänhet blir den partiordförande som hade mest framgång i valet statsminister.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-regeringen/narration/hb-c04-u0033-s001.wav",
