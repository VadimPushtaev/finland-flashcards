    "generation_seconds": 16.379186624020804
  },
  {
    "sentence_id": "hb-c03-u0128-s006",
    "text": "Andra delikatesser som hör början av vintern till är blinier, det vill säga plättar av bovetemjöl, som ingår i den ortodoxa fastlagstraditionen.",
    "engine": "supertonic",
    "voice": "F1",
