    "generation_seconds": 15.514367217023391
  },
  {
    "sentence_id": "hb-c03-u0121-s002",
    "text": "På olika högtider lagar eller köper man maträtter, bakverk, drycker och delikatesser som är typiska för den aktuella högtiden.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0121-s002.wav",
    "sample_rate": 44100,
    "seconds": 10.65795918367347,
    "peak": 0.2874755859375,
    "generation_seconds": 45.43159782001749
  },
  {
    "sentence_id": "hb-c03-u0122-s001",
    "text": "På många påskbord serveras lamm, ägg, memma, pasha och chokladägg.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0122-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.921088435374149,
    "peak": 0.3277587890625,
    "generation_seconds": 25.112901307002176
  },
  {
    "sentence_id": "hb-c03-u0122-s002",
    "text": "Äggen dekoreras och målas.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0122-s002.wav",
    "sample_rate": 44100,
    "seconds": 2.786394557823129,
    "peak": 0.377899169921875,
    "generation_seconds": 16.130748915020376
  },
  {
    "sentence_id": "hb-c03-u0122-s003",
    "text": "Att måla ägg är ursprungligen en ortodox sed.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0122-s003.wav",
    "sample_rate": 44100,
    "seconds": 4.388571428571429,
    "peak": 0.29266357421875,
    "generation_seconds": 20.994935257011093
  },
  {
    "sentence_id": "hb-c03-u0122-s004",
    "text": "Memma är en söt efterrätt av malt och rågmjöl som tillagas i ugn och äts med grädde och socker.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0122-s004.wav",
    "sample_rate": 44100,
    "seconds": 8.289523809523809,
    "peak": 0.27569580078125,
    "generation_seconds": 29.599064706999343
  },
  {
    "sentence_id": "hb-c03-u0122-s005",
    "text": "Pasha är en efterrätt gjord av kvarg.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0122-s005.wav",
    "sample_rate": 44100,
    "seconds": 3.7616326530612243,
    "peak": 0.501068115234375,
    "generation_seconds": 15.643172676034737
  },
  {
    "sentence_id": "hb-c03-u0123-s001",
    "text": "På valborg dricker man mjöd och äter munkar och struvor.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0123-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.015510204081632,
    "peak": 0.263580322265625,
    "generation_seconds": 18.057327869988512
  },
  {
    "sentence_id": "hb-c03-u0123-s002",
    "text": "Mjöd är en dryck som tillverkas genom jäsning av vatten, citron och socker och som många tillverkar hemma.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0123-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.125442176870749,
    "peak": 0.341888427734375,
    "generation_seconds": 32.75294891104568
  },
  {
    "sentence_id": "hb-c03-u0123-s003",
    "text": "Mjöd kan innehålla en liten mängd alkohol.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0123-s003.wav",
    "sample_rate": 44100,
    "seconds": 3.900952380952381,
    "peak": 0.382568359375,
    "generation_seconds": 16.635386696027126
  },
  {
    "sentence_id": "hb-c03-u0124-s001",
    "text": "På midsommar firar många sommaren genom att grilla ute.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0124-s001.wav",
    "sample_rate": 44100,
    "seconds": 4.876190476190477,
    "peak": 0.2276611328125,
    "generation_seconds": 21.62395090702921
  },
  {
    "sentence_id": "hb-c03-u0124-s002",
    "text": "På grillen grillas korv, kött och grönsaker.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0124-s002.wav",
    "sample_rate": 44100,
    "seconds": 4.179591836734694,
    "peak": 0.272552490234375,
    "generation_seconds": 17.142557574028615
  },
  {
    "sentence_id": "hb-c03-u0124-s003",
    "text": "Kring midsommar kommer den första potatisen för säsongen till affärerna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0124-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.408707482993197,
    "peak": 0.392852783203125,
    "generation_seconds": 28.068267359980382
  },
  {
    "sentence_id": "hb-c03-u0124-s004",
    "text": "De kokas och äts med smör och dill och sill.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0124-s004.wav",
    "sample_rate": 44100,
    "seconds": 4.1099319727891155,
    "peak": 0.331634521484375,
    "generation_seconds": 19.675045222975314
  },
  {
    "sentence_id": "hb-c03-u0125-s001",
    "text": "På sensommaren äter en del kräftor och ordnar kräftskiva för sina vänner.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0125-s001.wav",
    "sample_rate": 44100,
    "seconds": 6.478367346938776,
    "peak": 0.250213623046875,
    "generation_seconds": 34.26813093695091
  },
  {
    "sentence_id": "hb-c03-u0125-s002",
    "text": "Traditionen med kräftskivor kommer från de svenskspråkiga kusttrakterna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0125-s002.wav",
    "sample_rate": 44100,
    "seconds": 6.548027210884354,
    "peak": 0.45477294921875,
    "generation_seconds": 29.722003534960095
  },
  {
    "sentence_id": "hb-c03-u0126-s001",
    "text": "Den traditionella finska julmaten är mångsidig och läcker.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0126-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.154829931972789,
    "peak": 0.242645263671875,
    "generation_seconds": 25.391559890995268
  },
  {
    "sentence_id": "hb-c03-u0126-s002",
    "text": "I risgrynsgröten läggs en skalad mandel.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0126-s002.wav",
    "sample_rate": 44100,
    "seconds": 3.7616326530612243,
    "peak": 0.33441162109375,
    "generation_seconds": 20.518011035979725
  },
  {
    "sentence_id": "hb-c03-u0126-s003",
    "text": "Enligt vissa traditioner får den som hittar mandeln i sin gröt lycka.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0126-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.060408163265306,
    "peak": 0.298309326171875,
    "generation_seconds": 30.903347771032713
  },
  {
    "sentence_id": "hb-c03-u0126-s004",
    "text": "Glögg, det vill säga en varm, kryddad saftdryck, serveras under julen med pepparkakor.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0126-s004.wav",
    "sample_rate": 44100,
    "seconds": 7.592925170068027,
    "peak": 0.342437744140625,
    "generation_seconds": 28.182976167998277
  },
  {
    "sentence_id": "hb-c03-u0126-s005",
    "text": "Ibland innehåller glöggen också alkohol.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0126-s005.wav",
    "sample_rate": 44100,
    "seconds": 3.7616326530612243,
    "peak": 0.29150390625,
    "generation_seconds": 16.834048698015977
  },
  {
    "sentence_id": "hb-c03-u0126-s006",
    "text": "På Luciadagen äter man saffransbullar formade som bokstaven s.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0126-s006.wav",
    "sample_rate": 44100,
    "seconds": 5.642448979591837,
    "peak": 0.327178955078125,
    "generation_seconds": 24.225809953990392
  },
  {
    "sentence_id": "hb-c03-u0127-s001",
    "text": "På julbordet serveras de bästa traditionella delikatesserna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
