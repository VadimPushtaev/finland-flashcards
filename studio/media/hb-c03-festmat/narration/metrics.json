    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0128-s006.wav",
    "sample_rate": 44100,
    "seconds": 12.817414965986394,
    "peak": 0.44775390625,
    "generation_seconds": 51.70978826301871
  },
  {
    "sentence_id": "hb-c03-u0129-s001",
    "text": "I Finland dricker människorna vanligtvis vatten, mjölk eller ibland surmjölk till maten.",
