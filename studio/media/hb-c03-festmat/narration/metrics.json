    "generation_seconds": 26.848955675028265
  },
  {
    "sentence_id": "hb-c03-u0128-s003",
    "text": "En fastlagsbulle är en stor, rund bulle skuren på mitten.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0128-s003.wav",
    "sample_rate": 44100,
