    "peak": 0.278106689453125,
    "generation_seconds": 15.330311224039178
  },
  {
    "sentence_id": "hb-c03-u0127-s003",
    "text": "Med den serveras kokt potatis och lådrätter, det vill säga rotsaksrätter tillagade i ugn, till exempel kålrots-, potatis- och morotslåda.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0127-s003.wav",
    "sample_rate": 44100,
    "seconds": 12.329795918367347,
    "peak": 0.33367919921875,
    "generation_seconds": 48.9179981930065
  },
  {
    "sentence_id": "hb-c03-u0127-s004",
    "text": "Till julbordet hör också sillsallad, det vill säga en sallad gjord av kokta och hackade rotsaker.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0127-s004.wav",
    "sample_rate": 44100,
    "seconds": 8.6378231292517,
    "peak": 0.3463134765625,
    "generation_seconds": 41.695215009036474
  },
  {
    "sentence_id": "hb-c03-u0127-s005",
    "text": "På julen äter man också mycket fisk och olika slags sillar, strömming, gravad lax samt lutfisk av torkad fisk, som enligt många är en av de bästa juldelikatesserna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0127-s005.wav",
    "sample_rate": 44100,
    "seconds": 14.280272108843537,
