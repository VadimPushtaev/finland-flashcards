    "generation_seconds": 63.15260709600989
  },
  {
    "sentence_id": "hb-c03-u0128-s001",
    "text": "I februari finns det runebergstårtor och fastlagsbullar i affärerna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0128-s001.wav",
    "sample_rate": 44100,
    "seconds": 6.199727891156463,
    "peak": 0.315216064453125,
    "generation_seconds": 27.336237322015222
  },
  {
    "sentence_id": "hb-c03-u0128-s002",
    "text": "Runebergstårtorna smakar mandel och ovanpå dem finns hallonsylt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-festmat/narration/hb-c03-u0128-s002.wav",
    "sample_rate": 44100,
    "seconds": 5.851428571428571,
