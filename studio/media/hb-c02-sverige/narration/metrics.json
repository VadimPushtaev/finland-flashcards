    "generation_seconds": 15.119032736984082,
    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0017-s002",
    "text": "Kolonialism innebär att ett land erövrar hela länder eller områden i andra världsdelar och utnyttjar deras resurser, såsom arbetskraft och naturresurser.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-sverige/narration/hb-c02-u0017-s002.wav",
    "sample_rate": 44100,
    "seconds": 13.305034013605443,
    "peak": 0.43212890625,
    "generation_seconds": 19.510758794029243,
    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0017-s003",
    "text": "Inom kolonialismen påverkar man också de lokala sederna, till exempel språket, religionen och utbildningen, i de erövrade länderna eller områdena.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-sverige/narration/hb-c02-u0017-s003.wav",
    "sample_rate": 44100,
    "seconds": 12.469115646258503,
    "peak": 0.305389404296875,
    "generation_seconds": 21.04579044698039,
    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0018-s001",
    "text": "Den kraftiga utvecklingen och blomstringen i de länder som deltog i kolonialismen skedde delvis på koloniernas bekostnad.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-sverige/narration/hb-c02-u0018-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.170340136054422,
