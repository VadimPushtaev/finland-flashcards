    "generation_seconds": 12.230652161990292,
    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0016-s003",
    "text": "Man började ägna uppmärksamhet åt mänskliga rättigheter och ville göra staten till en rättsstat.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
