    "generation_seconds": 16.076415530988015,
    "generation_run": "initial"
  },
  {
    "sentence_id": "hb-c02-u0010-s002",
    "text": "I Sverige och den östra delen av riket, Finland, innebar detta lutherdom, som är en inriktning inom den protestantiska kristendomen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
