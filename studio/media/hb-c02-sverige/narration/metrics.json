  },
  {
    "sentence_id": "hb-c02-u0010-s001",
    "text": "Till följd av reformationen övergick man i en del av Europa på femtonhundratalet från katolicismen till protestantisk tro.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
