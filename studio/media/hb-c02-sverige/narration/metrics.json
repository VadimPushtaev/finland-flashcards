    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0016-s006",
    "text": "Viktiga mål under upplysningen var rösträtt, yttrandefrihet och religionsfrihet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
