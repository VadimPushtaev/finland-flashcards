  },
  {
    "sentence_id": "hb-c02-u0016-s001",
    "text": "I slutet av sextonhundratalet inleddes en period i Europa som kallades upplysningen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
