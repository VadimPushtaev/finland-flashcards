    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0018-s002",
    "text": "Länderna som deltog i koloniseringen, till exempel Sverige och därmed också Finland, drog nytta av naturresurserna, råvarorna och produkterna i kolonierna samt handeln med dem.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-sverige/narration/hb-c02-u0018-s002.wav",
