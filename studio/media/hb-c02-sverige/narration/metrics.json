    "generation_seconds": 10.2965528749628,
    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0017-s001",
    "text": "Samtidigt som man i Europa diskuterade mänskliga rättigheter utövade många europeiska länder kolonialism.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-sverige/narration/hb-c02-u0017-s001.wav",
    "sample_rate": 44100,
