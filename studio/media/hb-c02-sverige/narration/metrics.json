    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0016-s005",
    "text": "I Sverige till exempel förbjöd man tortyr som förhörsmetod.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-sverige/narration/hb-c02-u0016-s005.wav",
