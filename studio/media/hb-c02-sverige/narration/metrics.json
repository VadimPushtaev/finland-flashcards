    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0016-s004",
    "text": "I en rättsstat har alla människor mänskliga rättigheter, politiska rättigheter och rätt att delta i samhället.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
