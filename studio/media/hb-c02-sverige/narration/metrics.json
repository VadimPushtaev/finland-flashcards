    "generation_run": "resume-seed42"
  },
  {
    "sentence_id": "hb-c02-u0016-s002",
    "text": "Under upplysningen ville man minska den enväldige kungens makt och kyrkans stora inflytande.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
