[
  {
    "sentence_id": "hb-c02-u0061-s001",
    "text": "Ännu i slutet av artonhundratalet var det främst familjen, bygemenskapen och enskilda förmögna välgörare samt framför allt kyrkan som tog hand om fattiga och sjuka i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0061-s001.wav",
    "sample_rate": 44100,
    "seconds": 15.116190476190477,
    "peak": 0.33709716796875,
    "generation_seconds": 18.96103661804227
  },
  {
    "sentence_id": "hb-c02-u0061-s002",
    "text": "Sedan överfördes ansvaret för landsbygdens fattiga allt mer från kyrkan till kommunerna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0061-s002.wav",
    "sample_rate": 44100,
    "seconds": 7.732244897959184,
    "peak": 0.436920166015625,
    "generation_seconds": 12.524700812005904
  },
  {
    "sentence_id": "hb-c02-u0061-s003",
    "text": "De fattiga arbetarna fick ekonomisk hjälp bara om de samtidigt förband sig att arbeta för en gård, en kommun eller en församling.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0061-s003.wav",
    "sample_rate": 44100,
    "seconds": 11.284897959183674,
    "peak": 0.506591796875,
    "generation_seconds": 29.139023271971382
  },
  {
    "sentence_id": "hb-c02-u0062-s001",
    "text": "Under industrialiseringen i slutet av artonhundratalet blev det allmän diskussion om fabriksarbetarnas usla villkor och fattigdom.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0062-s001.wav",
    "sample_rate": 44100,
    "seconds": 11.633197278911565,
    "peak": 0.46563720703125,
    "generation_seconds": 22.42916158301523
  },
  {
    "sentence_id": "hb-c02-u0062-s002",
    "text": "Det lilla socialskydd fabriksarbetarna hade sköttes främst av arbetsgivarna och småningom även av medborgarorganisationer.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0062-s002.wav",
    "sample_rate": 44100,
    "seconds": 11.00625850340136,
    "peak": 0.310089111328125,
    "generation_seconds": 19.42465011496097
  },
  {
    "sentence_id": "hb-c02-u0062-s003",
    "text": "På fabriksorter ägde och administrerade fabriksägaren också arbetarnas bostäder, daghem och åldringsvård.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0062-s003.wav",
    "sample_rate": 44100,
    "seconds": 9.264761904761905,
    "peak": 0.335235595703125,
    "generation_seconds": 20.032117830996867
  },
  {
    "sentence_id": "hb-c02-u0062-s004",
    "text": "Fabriken påverkade hela arbetarnas livsmiljö och knöt dem tätt till arbetsgivaren.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0062-s004.wav",
    "sample_rate": 44100,
    "seconds": 7.174965986394557,
    "peak": 0.41668701171875,
    "generation_seconds": 17.50659157295013
  },
  {
    "sentence_id": "hb-c02-u0063-s001",
    "text": "Samhällsaktiviteten i organisationerna var viktig för demokratins utveckling i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0063-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.87156462585034,
    "peak": 0.360137939453125,
    "generation_seconds": 18.344230710994452
  },
  {
    "sentence_id": "hb-c02-u0063-s002",
    "text": "Till de första stora folkrörelserna i Finland hörde nykterhetsrörelsen, gymnastik- och idrottsrörelsen, arbetar- och fackföreningsrörelserna samt ungdomsföreningar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0063-s002.wav",
    "sample_rate": 44100,
    "seconds": 14.419591836734694,
    "peak": 0.329345703125,
    "generation_seconds": 32.671313847997226
  },
  {
    "sentence_id": "hb-c02-u0063-s003",
    "text": "Folkrörelserna och samhällsaktiviteten hjälpte till att förena finländarna som nation.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0063-s003.wav",
    "sample_rate": 44100,
    "seconds": 7.801904761904762,
    "peak": 0.285369873046875,
    "generation_seconds": 16.087435258028563
  },
  {
    "sentence_id": "hb-c02-u0063-s004",
    "text": "De utbildade och upplyste finländarna, skapade nationalkänsla och lärde människorna att sköta gemensamma ärenden.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0063-s004.wav",
    "sample_rate": 44100,
    "seconds": 9.822040816326531,
    "peak": 0.299652099609375,
    "generation_seconds": 26.744315723946784
  },
  {
    "sentence_id": "hb-c02-u0063-s005",
    "text": "Allt detta behövdes när Finland blev en självständig stat nittonhundrasjutton.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0063-s005.wav",
    "sample_rate": 44100,
    "seconds": 7.035646258503402,
    "peak": 0.473846435546875,
    "generation_seconds": 19.099491956003476
  },
  {
    "sentence_id": "hb-c02-u0064-s001",
    "text": "Grunden till den finska välfärden är heltäckande tjänster inom social- och utkomstskydd.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0064-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.732244897959184,
    "peak": 0.256500244140625,
    "generation_seconds": 19.3568633350078
  },
  {
    "sentence_id": "hb-c02-u0064-s002",
    "text": "Socialskyddssystemet, en struktur av sociala förmåner och understöd, utvecklades senare i Finland än i de övriga nordiska länderna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0064-s002.wav",
    "sample_rate": 44100,
    "seconds": 11.842176870748299,
    "peak": 0.29144287109375,
    "generation_seconds": 29.89964553900063
  },
  {
    "sentence_id": "hb-c02-u0064-s003",
    "text": "År artonhundranittiofem stiftades en lag om arbetsolycksfallsförsäkring.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0064-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.478367346938776,
    "peak": 0.4124755859375,
    "generation_seconds": 14.399344123958144
  },
  {
    "sentence_id": "hb-c02-u0064-s004",
    "text": "Det var första steget i utvecklandet av finsk socialförsäkring, men var också länge den enda formen av socialförsäkring i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0064-s004.wav",
    "sample_rate": 44100,
    "seconds": 11.354557823129252,
    "peak": 0.30181884765625,
    "generation_seconds": 26.19767080596648
  },
  {
    "sentence_id": "hb-c02-u0064-s005",
    "text": "Lagen fastslog att arbetstagaren skulle betalas ersättning i fall av arbetsolycka eller yrkessjukdom.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0064-s005.wav",
    "sample_rate": 44100,
    "seconds": 8.916462585034013,
    "peak": 0.425872802734375,
    "generation_seconds": 16.098785906971898
  },
  {
    "sentence_id": "hb-c02-u0064-s006",
    "text": "Den tidens finska socialförsäkring var internationellt sett gammalmodig, men i den oeniga politiska atmosfär som härskade var det mycket svårt att införa försäkringar för ålderdom, arbetsoförmåga eller sjukdom.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0064-s006.wav",
    "sample_rate": 44100,
    "seconds": 17.902585034013605,
    "peak": 0.3936767578125,
    "generation_seconds": 41.03676940500736
  },
  {
    "sentence_id": "hb-c02-u0065-s001",
    "text": "Även om socialministeriet, som skulle ansvara för socialskyddet, grundades vid samma tid som Finland blev självständigt nittonhundrasjutton, började man skapa omfattande offentliga stödsystem i Finland först i slutet av nittonhundratrettiotalet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0065-s001.wav",
    "sample_rate": 44100,
    "seconds": 21.037278911564627,
    "peak": 0.305206298828125,
    "generation_seconds": 49.85389436001424
  },
  {
    "sentence_id": "hb-c02-u0065-s002",
    "text": "Den första folkpensionslagen godkändes nittonhundratrettiosju.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0065-s002.wav",
    "sample_rate": 44100,
    "seconds": 5.642448979591837,
    "peak": 0.319488525390625,
    "generation_seconds": 13.194339124020189
  },
  {
    "sentence_id": "hb-c02-u0065-s003",
    "text": "Lagen gav de försäkrade folkpension, det vill säga ekonomisk hjälp för ålderdomen och vid arbetsoförmåga.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0065-s003.wav",
    "sample_rate": 44100,
    "seconds": 9.125442176870749,
    "peak": 0.29437255859375,
    "generation_seconds": 17.052186449989676
  },
  {
    "sentence_id": "hb-c02-u0065-s004",
    "text": "Samma år grundades Folkpensionsanstalten eff pe a (på finska Kela), vars uppgift var att betala folkpensionen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0065-s004.wav",
    "sample_rate": 44100,
    "seconds": 9.613061224489796,
    "peak": 0.279693603515625,
    "generation_seconds": 26.293566033011302
  },
  {
    "sentence_id": "hb-c02-u0066-s001",
    "text": "Den ursprungliga målsättningen med att göra Finland till en välfärdsstat var att minska fattigdomen och garantera en daglig utkomst för alla finländare.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0066-s001.wav",
    "sample_rate": 44100,
    "seconds": 12.678095238095239,
    "peak": 0.447235107421875,
    "generation_seconds": 27.03778777795378
  },
  {
    "sentence_id": "hb-c02-u0066-s002",
    "text": "Man ansåg att detta skulle stabilisera samhället och dess utveckling och minska stödet för alla slags extrema rörelser.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0066-s002.wav",
    "sample_rate": 44100,
    "seconds": 10.309659863945578,
    "peak": 0.370147705078125,
    "generation_seconds": 29.460970529995393
  },
  {
    "sentence_id": "hb-c02-u0066-s003",
    "text": "Tanken var också att mindre inkomstskillnader skulle göra människorna mer jämlika.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0066-s003.wav",
    "sample_rate": 44100,
    "seconds": 7.244625850340136,
    "peak": 0.30133056640625,
    "generation_seconds": 20.825552624010015
  },
  {
    "sentence_id": "hb-c02-u0066-s004",
    "text": "Det skulle leda till att Finlands folk skulle vara enigare och alla skulle vilja arbeta för att utveckla landet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0066-s004.wav",
    "sample_rate": 44100,
    "seconds": 9.404081632653062,
    "peak": 0.475067138671875,
    "generation_seconds": 31.631421554018743
  },
  {
    "sentence_id": "hb-c02-u0066-s005",
    "text": "Det skulle vara lättare för olika befolkningsgrupper, till exempel rika och fattiga och grupper med olika politiska uppfattningar, att leva i fred med varandra.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0066-s005.wav",
    "sample_rate": 44100,
    "seconds": 13.514013605442177,
    "peak": 0.397369384765625,
    "generation_seconds": 43.10617411299609
  },
  {
    "sentence_id": "hb-c02-u0067-s001",
    "text": "Under nittonhundrasextiotalet och nittonhundrasjuttiotalet utvecklades Finland småningom till en nordisk välfärdsstat.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0067-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.448979591836734,
    "peak": 0.2669677734375,
    "generation_seconds": 44.590500466991216
  },
  {
    "sentence_id": "hb-c02-u0067-s002",
    "text": "Sverige var ett modelland i fråga om välfärden och påverkade Finland mycket.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0067-s002.wav",
    "sample_rate": 44100,
    "seconds": 6.896326530612245,
    "peak": 0.272186279296875,
    "generation_seconds": 25.361299754003994
  },
  {
    "sentence_id": "hb-c02-u0067-s003",
    "text": "Staten tog allt mer ansvar för medborgarnas välfärd.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0067-s003.wav",
    "sample_rate": 44100,
    "seconds": 4.876190476190477,
    "peak": 0.4248046875,
    "generation_seconds": 12.80488107597921
  },
  {
    "sentence_id": "hb-c02-u0067-s004",
    "text": "Medborgarna fick fler inkomstöverföringar från staten, till exempel moderskapspenning och sjukpenning samt ersättningar för läkemedelsutgifter och läkararvoden.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0067-s004.wav",
    "sample_rate": 44100,
    "seconds": 13.653333333333334,
    "peak": 0.312896728515625,
    "generation_seconds": 30.460998394992203
  },
  {
    "sentence_id": "hb-c02-u0067-s005",
    "text": "Det satsades på utbildning och sjukvård genom att det byggdes nya sjukhus och skolor och läkarutbildningen utvidgades.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0067-s005.wav",
    "sample_rate": 44100,
    "seconds": 10.170340136054422,
    "peak": 0.262420654296875,
    "generation_seconds": 34.802170259004924
  },
  {
    "sentence_id": "hb-c02-u0068-s001",
    "text": "Välfärdsstaten utvecklades ur jämlikhetsperspektiv.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0068-s001.wav",
    "sample_rate": 44100,
    "seconds": 4.9458503401360545,
    "peak": 0.33831787109375,
    "generation_seconds": 18.83213714096928
  },
  {
    "sentence_id": "hb-c02-u0068-s002",
    "text": "På nittonhundrasjuttiotalet började alla barn oberoende av samhällsklass gå samma kostnadsfria grundskola.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0068-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.404081632653062,
    "peak": 0.376617431640625,
    "generation_seconds": 28.180706556944642
  },
  {
    "sentence_id": "hb-c02-u0068-s003",
    "text": "De som studerade vid universitet, högskolor eller andra stadiets läroanstalter började få studiestöd, det vill säga ekonomiskt stöd för livet under studietiden.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0068-s003.wav",
    "sample_rate": 44100,
    "seconds": 13.862312925170068,
    "peak": 0.474395751953125,
    "generation_seconds": 37.584488444030285
  },
  {
    "sentence_id": "hb-c02-u0068-s004",
    "text": "Tack vare studiestödet hade barndomsfamiljens tillgångar inte längre så stor betydelse för om en ung vuxen hade ekonomisk möjlighet att utbilda sig till det yrke hen ville.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-valfard/narration/hb-c02-u0068-s004.wav",
    "sample_rate": 44100,
    "seconds": 14.001632653061224,
    "peak": 0.357177734375,
