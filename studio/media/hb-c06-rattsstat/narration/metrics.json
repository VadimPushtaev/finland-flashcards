    "generation_seconds": 20.785968589945696,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0010-s003",
    "text": "Dessa värderingar bildar en stabil grund för ett gott och rättvist samhälle.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0010-s003.wav",
