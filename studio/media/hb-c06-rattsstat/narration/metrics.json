    "peak": 0.295562744140625,
    "generation_seconds": 23.471387582016177,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0006-s001",
    "text": "I Finland måste alla följa finsk lag.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0006-s001.wav",
