    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0011-s001",
    "text": "Finland är ett världsligt, det vill säga sekulärt, land.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0011-s001.wav",
