    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0002-s001",
    "text": "Grundlagen har en högre ställning än övriga lagar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
