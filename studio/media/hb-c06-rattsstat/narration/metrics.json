    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0001-s006",
    "text": "Målet med indelningen är bland annat att trygga en jämlik och likvärdig behandling av människor.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
