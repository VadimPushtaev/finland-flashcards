    "seconds": 6.199727891156463,
    "peak": 0.33111572265625,
    "generation_seconds": 12.426127773011103,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0005-s004",
    "text": "Förundersökningsmyndigheterna utreder brott och säkerställer att medborgarna kan leva i fred och säkerhet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0005-s004.wav",
