    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0004-s001",
    "text": "I en rättsstat finns det också rättssäkerhet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0004-s001.wav",
