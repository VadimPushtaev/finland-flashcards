    "generation_seconds": 16.239984696963802,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0006-s003",
    "text": "Lagarna tryggar allas rättigheter och den allmänna ordningen i samhället.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0006-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.408707482993197,
    "peak": 0.41339111328125,
    "generation_seconds": 18.075229085050523,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0007-s001",
    "text": "I Finland anses det i allmänhet viktigt att följa lagar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0007-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.224489795918367,
    "peak": 0.300018310546875,
    "generation_seconds": 12.288033168995753,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0007-s002",
    "text": "Att bryta mot lagen är oacceptabelt och godkänns inte.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0007-s002.wav",
    "sample_rate": 44100,
    "seconds": 4.73687074829932,
    "peak": 0.37835693359375,
    "generation_seconds": 11.290258073946461,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0007-s003",
    "text": "Det är viktigt att lagarna är i linje med människornas allmänna rättskänsla, det vill säga uppfattningen om vad som är rätt och fel.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0007-s003.wav",
    "sample_rate": 44100,
    "seconds": 11.284897959183674,
    "peak": 0.401397705078125,
    "generation_seconds": 27.11687487491872,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0007-s004",
    "text": "Om lagen och människornas rättskänsla strider mot varandra, minskar respekten för lagen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0007-s004.wav",
    "sample_rate": 44100,
    "seconds": 7.9412244897959186,
    "peak": 0.2906494140625,
    "generation_seconds": 17.77144825004507,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0008-s001",
    "text": "Lagar bygger på värderingarna och normerna i samhället.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0008-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.085170068027211,
    "peak": 0.272491455078125,
    "generation_seconds": 12.505442876950838,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0008-s002",
    "text": "Med värderingar avses det som människorna anser vara viktiga och värda att eftersträva.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0008-s002.wav",
    "sample_rate": 44100,
    "seconds": 8.010884353741497,
    "peak": 0.299468994140625,
    "generation_seconds": 16.284201461006887,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0008-s003",
    "text": "Olika kulturer och religioner har olika värderingar, och också människor som lever i samma kultur har olika personliga värderingar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0008-s003.wav",
    "sample_rate": 44100,
    "seconds": 11.354557823129252,
    "peak": 0.307342529296875,
    "generation_seconds": 31.6739926940063,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0009-s001",
    "text": "Normer är etablerade tankar, regler eller påbud om hur människorna ska bete sig.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0009-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.244625850340136,
    "peak": 0.306365966796875,
    "generation_seconds": 19.071976788924076,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0009-s002",
    "text": "Normerna visar vad som anses vara acceptabelt beteende, rätt och fel och hur människorna borde leva.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0009-s002.wav",
    "sample_rate": 44100,
    "seconds": 8.777142857142858,
    "peak": 0.316497802734375,
    "generation_seconds": 24.69687604799401,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0010-s001",
    "text": "Grundläggande värderingar i det finländska samhället är en idé om det allmänna bästa och frihet, mänskliga rättigheter och likabehandling.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0010-s001.wav",
    "sample_rate": 44100,
    "seconds": 11.702857142857143,
    "peak": 0.36199951171875,
    "generation_seconds": 34.90198532899376,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0010-s002",
    "text": "Var och en ska ha möjlighet att studera, få ett yrke och vara framgångsrik i sitt liv.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0010-s002.wav",
