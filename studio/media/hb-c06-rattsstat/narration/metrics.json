    "generation_seconds": 13.155642674071714,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0004-s004",
    "text": "Enligt finsk lagstiftning ska en människa betraktas som oskyldig tills hens skuld har lagligen fastställts.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0004-s004.wav",
