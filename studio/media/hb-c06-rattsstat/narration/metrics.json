    "generation_seconds": 31.75685275392607,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0005-s003",
    "text": "Rättsväsendet ansvarar för att rättvisa straff utdelas för brott.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0005-s003.wav",
