    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0005-s002",
    "text": "Rättsväsendet omfattar domstolarna, statens rättshjälpsbyråer, Åklagarmyndigheten, Utsökningsverket, ekonomi- och skuldrådgivning, allmän intressebevakning samt Brottspåföljdsmyndigheten.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0005-s002.wav",
