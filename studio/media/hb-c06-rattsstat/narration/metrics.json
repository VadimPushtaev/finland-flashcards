    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0004-s002",
    "text": "Rättssäkerhet betyder att alla har lika rätt att få sin sak behandlad på behörigt sätt och utan ogrundat dröjsmål av en opartisk domstol eller någon annan myndighet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0004-s002.wav",
