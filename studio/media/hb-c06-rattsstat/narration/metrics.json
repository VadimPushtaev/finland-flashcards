    "generation_seconds": 19.07251096505206,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0005-s001",
    "text": "Rättsväsendet upprätthåller rättsstaten.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0005-s001.wav",
