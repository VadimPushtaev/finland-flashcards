    "generation_seconds": 9.632337426999584,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0006-s002",
    "text": "När en människa bor och lever i Finland är det viktigt att hen känner till lagarna i landet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0006-s002.wav",
    "sample_rate": 44100,
    "seconds": 7.87156462585034,
