    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0003-s003",
    "text": "Grundlagen bestämmer hur till exempel riksdagsledamöter, ministrar och presidenten utses.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0003-s003.wav",
