    "generation_seconds": 24.994157355977222,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c06-u0004-s003",
    "text": "Alla ärenden behandlas i domstol enligt lagen, jämlikt och likvärdigt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c06-rattsstat/narration/hb-c06-u0004-s003.wav",
