    "generation_seconds": 35.72323406999931,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0189-s002",
    "text": "Vid behov kan du även ha med dig en ledsagare, det vill säga en person som assisterar dig på resor.",
    "engine": "supertonic",
    "voice": "F1",
