    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0187-s002",
    "text": "Via handikapporganisationerna är det också möjligt att påverka samhällets verksamhet och ställningen för personer med funktionsnedsättning.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
