    "generation_seconds": 17.20091515313834,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0193-s002",
    "text": "Kontakta din social- och hälsocentral eller läkaren vid företagshälsovården.",
