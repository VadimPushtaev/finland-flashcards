    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0194-s002",
    "text": "En person med intellektuell funktionsnedsättning som behöver vård kan bo i ett familjehem.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
