    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0196-s001",
    "text": "Välfärdsområdena ordnar arbetsverksamhet (työtoiminta) och dagverksamhet (päivätoiminta) för personer med funktionsnedsättning.",
    "engine": "supertonic",
    "voice": "F1",
