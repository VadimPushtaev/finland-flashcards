    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0187-s001",
    "text": "I Finland finns det olika handikapp- och patientorganisationer som bevakar sina medlemmars intressen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
