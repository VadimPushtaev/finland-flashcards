    "generation_seconds": 48.4060021659825,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0190-s002",
    "text": "Du kan få rehabilitering om du på grund av din funktionsnedsättning eller sjukdom har stora svårigheter att klara av vardagen i hemmet, på jobbet eller i skolan.",
    "engine": "supertonic",
