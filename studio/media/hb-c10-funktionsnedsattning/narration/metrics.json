    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0188-s002",
    "text": "Bostaden kan till exempel byggas om så att du kan röra dig med en rullstol i den.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
