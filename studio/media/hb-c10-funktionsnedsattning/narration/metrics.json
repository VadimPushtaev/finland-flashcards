    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0189-s004",
    "text": "Du kan ansöka om färdtjänst hos funktionshinderservicen i ditt område.",
    "engine": "supertonic",
    "voice": "F1",
