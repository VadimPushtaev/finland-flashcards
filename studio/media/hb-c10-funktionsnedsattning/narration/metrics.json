    "generation_seconds": 52.81955451914109,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0188-s004",
    "text": "Socialarbetaren inom funktionshinderservicen i ditt område bedömer tillsammans med dig om det behövs ändringsarbeten i din bostad.",
    "engine": "supertonic",
    "voice": "F1",
