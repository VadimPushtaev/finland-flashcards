    "generation_seconds": 35.08312761201523,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0188-s001",
    "text": "Om det måste göras ändringsarbeten eller installeras fasta hjälpmedel i din bostad kan du få ersättning för detta.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
