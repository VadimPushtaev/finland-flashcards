    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c10-u0188-s003",
    "text": "Fasta hjälpmedel kan till exempel vara olika typer av lyftanordningar samt brandvarnare och dörrklocka för personer med hörselnedsättning, där ljudet har ersatts med lampor.",
    "engine": "supertonic",
    "voice": "F1",
