    "generation_seconds": 14.983445480000228
  },
  {
    "sentence_id": "hb-c02-u0002-s001",
    "text": "De första skriftliga källorna om Finland är från elvahundratalet och tolvhundratalet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0002-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.87156462585034,
    "peak": 0.358001708984375,
    "generation_seconds": 26.105814724985976
  },
  {
    "sentence_id": "hb-c02-u0002-s002",
    "text": "Då anslöts Finlands territorium med hjälp av korståg till påven i Roms maktkrets och det medeltida nätverket av hansaköpmän.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0002-s002.wav",
    "sample_rate": 44100,
    "seconds": 10.936598639455783,
    "peak": 0.27947998046875,
    "generation_seconds": 26.470992522954475
  },
  {
    "sentence_id": "hb-c02-u0003-s001",
    "text": "Den katolska kyrkan kom till Finland via Sverige och den ortodoxa kyrkan från Novgorod i öster, nuvarande Rysslands område.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0003-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.936598639455783,
    "peak": 0.335540771484375,
    "generation_seconds": 26.442102449014783
  },
  {
    "sentence_id": "hb-c02-u0003-s002",
    "text": "Nöteborgsfreden tretton hundra tjugo tre avslutade kriget mellan Sverige och Novgorod om herraväldet i området.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0003-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.891700680272109,
    "peak": 0.31561279296875,
    "generation_seconds": 19.215083290007897,
    "generation_run": "pronunciation-retake-seed42"
  },
  {
    "sentence_id": "hb-c02-u0003-s003",
    "text": "Med freden etablerades den katolska tron i Finlands västra delar och den ortodoxa tron i landets östra delar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0003-s003.wav",
    "sample_rate": 44100,
    "seconds": 9.613061224489796,
    "peak": 0.33050537109375,
    "generation_seconds": 22.57204639801057
  },
  {
    "sentence_id": "hb-c02-u0003-s004",
    "text": "Denna gräns mellan religionerna finns fortfarande, men med reformationen byttes den katolska tron till den lutherska.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0003-s004.wav",
    "sample_rate": 44100,
    "seconds": 9.682721088435374,
    "peak": 0.2857666015625,
    "generation_seconds": 17.403939023031853
  },
  {
    "sentence_id": "hb-c02-u0004-s001",
    "text": "Under det svenska styret fanns det på Finlands område människogrupper som kommit från olika håll vid olika tidpunkter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0004-s001.wav",
    "sample_rate": 44100,
    "seconds": 9.891700680272109,
