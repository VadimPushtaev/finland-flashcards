    "generation_seconds": 18.027928710042033
  },
  {
    "sentence_id": "hb-c02-u0001-s003",
    "text": "Namnet på Finlands äldsta stad, Åbo (Turku), betyder handelsplats.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0001-s003.wav",
