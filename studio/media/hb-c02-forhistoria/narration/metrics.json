    "generation_seconds": 18.458715080982074
  },
  {
    "sentence_id": "hb-c02-u0004-s002",
    "text": "De levde i små samhällen och bildade inget enhetligt folk eller någon enhetlig stat.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c02-forhistoria/narration/hb-c02-u0004-s002.wav",
    "sample_rate": 44100,
