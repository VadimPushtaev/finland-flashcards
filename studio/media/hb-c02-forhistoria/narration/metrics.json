    "generation_seconds": 14.157787979987916
  },
  {
    "sentence_id": "hb-c02-u0004-s003",
    "text": "Sverige införlivade delar av det område som i dag kallas Finland med sitt rike under elvahundratalet till trettonhundratalet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
