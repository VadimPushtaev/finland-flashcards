  },
  {
    "sentence_id": "hb-c02-u0001-s002",
    "text": "Bosättningen utvecklades först vid vattendrag och det finländska territoriet har alltid använts för livlig handelstrafik.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
