    "generation_seconds": 14.75462098303251
  },
  {
    "sentence_id": "hb-c02-u0005-s003",
    "text": "De förändringar, till exempel reformationen och upplysningen, som skedde i Sverige och övriga Europa under dessa århundraden syntes också i Finland.",
    "engine": "supertonic",
    "voice": "F1",
