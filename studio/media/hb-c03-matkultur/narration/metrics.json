    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0111-s003.wav",
    "sample_rate": 44100,
    "seconds": 5.50312925170068,
    "peak": 0.31158447265625,
    "generation_seconds": 20.90562835300807
  },
  {
    "sentence_id": "hb-c03-u0111-s004",
    "text": "Maträtter som är gemensamma med svenskarnas är till exempel ärtsoppa, pannkaka, köttbullar, kanelbullar och fastlagsbullar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0111-s004.wav",
    "sample_rate": 44100,
    "seconds": 10.936598639455783,
    "peak": 0.435577392578125,
    "generation_seconds": 37.05266582098557
  },
  {
    "sentence_id": "hb-c03-u0112-s001",
    "text": "På vintern är grönsakerna dyrare än på sommaren, eftersom många av dem importeras till Finland från utlandet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0112-s001.wav",
    "sample_rate": 44100,
    "seconds": 9.613061224489796,
    "peak": 0.26348876953125,
    "generation_seconds": 27.138226596987806
  },
  {
    "sentence_id": "hb-c03-u0112-s002",
    "text": "I dag finns nästan alla livsmedel tillgängliga året om, men många följer ändå skördesäsongen i sin matlagning.",
