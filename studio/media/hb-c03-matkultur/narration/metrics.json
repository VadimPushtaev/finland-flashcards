    "peak": 0.271942138671875,
    "generation_seconds": 34.579308928980026
  },
  {
    "sentence_id": "hb-c03-u0108-s001",
    "text": "För många är det också viktigt att djuren som används till mat har behandlats väl.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0108-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.244625850340136,
    "peak": 0.295379638671875,
    "generation_seconds": 32.36975481599802
  },
  {
    "sentence_id": "hb-c03-u0108-s002",
    "text": "Många äter ingen animalisk mat alls, eftersom de inte vill skada djur eller eftersom de vill minska koldioxidutsläppen från matproduktionen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0108-s002.wav",
    "sample_rate": 44100,
    "seconds": 12.051156462585034,
    "peak": 0.342559814453125,
    "generation_seconds": 46.023784950957634
  },
  {
    "sentence_id": "hb-c03-u0108-s003",
    "text": "Veganismen och vegetarianismen har ökat i Finland under de senaste tjugo åren.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0108-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.896326530612245,
    "peak": 0.26715087890625,
    "generation_seconds": 28.884011332993396
  },
  {
    "sentence_id": "hb-c03-u0108-s004",
    "text": "En vegansk kost innehåller inga animaliska produkter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0108-s004.wav",
    "sample_rate": 44100,
    "seconds": 4.876190476190477,
    "peak": 0.26654052734375,
    "generation_seconds": 20.27295639005024
  },
  {
    "sentence_id": "hb-c03-u0109-s001",
    "text": "Traditionell finsk mat har varit mild.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0109-s001.wav",
    "sample_rate": 44100,
    "seconds": 3.5526530612244898,
    "peak": 0.345458984375,
    "generation_seconds": 17.147916762973182
  },
  {
    "sentence_id": "hb-c03-u0109-s002",
    "text": "Man använde lite kryddor, eftersom de måste hämtas långt ifrån och var dyra.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0109-s002.wav",
    "sample_rate": 44100,
    "seconds": 6.757006802721088,
    "peak": 0.294891357421875,
    "generation_seconds": 29.67184588999953
  },
  {
    "sentence_id": "hb-c03-u0109-s003",
    "text": "Finland var länge ett fattigt land, där maten var anspråkslös och enkel.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0109-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.408707482993197,
