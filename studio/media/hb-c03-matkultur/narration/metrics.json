    "generation_seconds": 25.407419201976154
  },
  {
    "sentence_id": "hb-c03-u0109-s004",
    "text": "Typisk finsk mat var kött och fisk med kokt potatis.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0109-s004.wav",
    "sample_rate": 44100,
    "seconds": 4.806530612244898,
    "peak": 0.348114013671875,
    "generation_seconds": 21.575605709978845
  },
  {
    "sentence_id": "hb-c03-u0110-s001",
    "text": "Den traditionella matkulturen i Finland är tudelad.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0110-s001.wav",
    "sample_rate": 44100,
    "seconds": 4.73687074829932,
    "peak": 0.322540283203125,
    "generation_seconds": 24.8762983760098
  },
  {
    "sentence_id": "hb-c03-u0110-s002",
    "text": "I västra Finland har matkulturen inspirerats mycket av den svenska matkulturen och i östra Finland av den ryska.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0110-s002.wav",
    "sample_rate": 44100,
    "seconds": 10.170340136054422,
    "peak": 0.3212890625,
    "generation_seconds": 46.500360339006875
  },
  {
    "sentence_id": "hb-c03-u0110-s003",
    "text": "I norra Finland bedriver man dessutom renskötsel, och därför används ofta också renkött.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0110-s003.wav",
    "sample_rate": 44100,
    "seconds": 7.9412244897959186,
    "peak": 0.504486083984375,
    "generation_seconds": 38.18655236001359
  },
  {
    "sentence_id": "hb-c03-u0111-s001",
    "text": "Ryska maträtter och matlagningsmetoder gör att den finska matkulturen skiljer sig från den i de övriga nordiska länderna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0111-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.24,
    "peak": 0.394439697265625,
    "generation_seconds": 54.687234588956926
  },
  {
    "sentence_id": "hb-c03-u0111-s002",
    "text": "Finländarna använder gärna svamp i maten och lagar karelsk stek och karelska piroger.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0111-s002.wav",
    "sample_rate": 44100,
    "seconds": 7.732244897959184,
