    "generation_seconds": 35.78747870103689
  },
  {
    "sentence_id": "hb-c03-u0106-s003",
    "text": "Var och en betalar också ofta endast sin egen mat när man äter på restaurang.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0106-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.6873469387755105,
    "peak": 0.27130126953125,
    "generation_seconds": 30.300598818983417
  },
  {
    "sentence_id": "hb-c03-u0107-s001",
    "text": "Många är noggranna med att maten de äter är hälsosam, ekologisk och närproducerad.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0107-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.383945578231293,
    "peak": 0.2763671875,
    "generation_seconds": 31.08475919801276
  },
  {
    "sentence_id": "hb-c03-u0107-s002",
    "text": "Många har minskat på användningen av fett och salt och ökat mängden frukt och grönsaker i sin kost.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0107-s002.wav",
    "sample_rate": 44100,
