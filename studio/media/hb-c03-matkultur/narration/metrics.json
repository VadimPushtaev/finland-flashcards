    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0105-s002.wav",
    "sample_rate": 44100,
    "seconds": 12.817414965986394,
