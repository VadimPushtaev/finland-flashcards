    "generation_seconds": 41.053950928966515
  },
  {
    "sentence_id": "hb-c03-u0104-s001",
    "text": "Att besöka torg och saluhallar eller små specialbutiker är mer sällsynt, men möjligt, i synnerhet i de större städerna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0104-s001.wav",
