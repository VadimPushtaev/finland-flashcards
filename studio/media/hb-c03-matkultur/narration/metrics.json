    "generation_seconds": 35.465290809981525
  },
  {
    "sentence_id": "hb-c03-u0104-s002",
    "text": "Torg är populära sommartid.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0104-s002.wav",
