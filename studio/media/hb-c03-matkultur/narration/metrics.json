    "generation_seconds": 34.22247783798957
  },
  {
    "sentence_id": "hb-c03-u0102-s001",
    "text": "Eftersom Finland tidigare var ett land med låg levnadsstandard, är många fortfarande noggranna med att inte laga för mycket mat, som sedan slängs.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0102-s001.wav",
    "sample_rate": 44100,
    "seconds": 12.329795918367347,
    "peak": 0.373046875,
    "generation_seconds": 48.206866976979654
  },
  {
    "sentence_id": "hb-c03-u0102-s002",
    "text": "För att det inte ska uppstå något matsvinn är i synnerhet de äldre generationerna av den åsikten att man äter upp allt man har på tallriken.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0102-s002.wav",
    "sample_rate": 44100,
    "seconds": 11.981496598639456,
    "peak": 0.381011962890625,
    "generation_seconds": 48.620815931994
  },
  {
    "sentence_id": "hb-c03-u0102-s003",
    "text": "På matställen, där man själv får ta mat åt sig, tar man endast så mycket mat som man orkar äta.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0102-s003.wav",
    "sample_rate": 44100,
    "seconds": 8.289523809523809,
    "peak": 0.309051513671875,
    "generation_seconds": 30.957462600024883
  },
  {
    "sentence_id": "hb-c03-u0103-s001",
    "text": "I Finland lagar både männen och kvinnorna i hushållen mat och gör dagliga matinköp.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0103-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.1053061224489795,
    "peak": 0.2694091796875,
    "generation_seconds": 30.04649028601125
  },
  {
    "sentence_id": "hb-c03-u0103-s002",
    "text": "Matlagning är en vanlig hobby, och människorna vill testa nya smaker och matlagningsmetoder.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0103-s002.wav",
    "sample_rate": 44100,
    "seconds": 8.080544217687075,
    "peak": 0.290313720703125,
    "generation_seconds": 29.487633258046117
  },
  {
    "sentence_id": "hb-c03-u0103-s003",
    "text": "Olika länders kök och varierande mattrender kommer till finländarnas kännedom via internet, medier och resor och tack vare att Finland internationaliseras.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0103-s003.wav",
