    "generation_seconds": 19.751549437991343
  },
  {
    "sentence_id": "hb-c03-u0105-s001",
    "text": "Förr åt människorna i Finland för det mesta potatis, men numera är ris och pasta vanliga.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0105-s001.wav",
