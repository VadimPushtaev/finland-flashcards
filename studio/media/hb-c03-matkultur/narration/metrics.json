  },
  {
    "sentence_id": "hb-c03-u0104-s003",
    "text": "På sommaren kan det dessutom ordnas torgevenemang för lokala producenter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0104-s003.wav",
    "sample_rate": 44100,
