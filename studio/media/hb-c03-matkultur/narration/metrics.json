    "generation_seconds": 46.513829517993145
  },
  {
    "sentence_id": "hb-c03-u0106-s002",
    "text": "I allmänhet beställer var och en i sällskapet en egen portion åt sig, och man delar vanligtvis inte på maten.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c03-matkultur/narration/hb-c03-u0106-s002.wav",
    "sample_rate": 44100,
