  },
  {
    "sentence_id": "hb-c04-u0001-s002",
    "text": "Det betyder att folket i Finland har makt att bestämma hur staten ska styras.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0001-s002.wav",
    "sample_rate": 44100,
    "seconds": 6.408707482993197,
    "peak": 0.296875,
    "generation_seconds": 15.632285855012015
  },
  {
    "sentence_id": "hb-c04-u0001-s003",
    "text": "Demokratin i Finland är en representativ demokrati, det vill säga medborgarna väljer representanter för sig själva som fattar beslut för dem.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0001-s003.wav",
    "sample_rate": 44100,
    "seconds": 12.120816326530612,
    "peak": 0.31927490234375,
    "generation_seconds": 28.55841383698862
  },
  {
    "sentence_id": "hb-c04-u0001-s004",
    "text": "Representanterna väljs i rättvisa och fria val.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0001-s004.wav",
    "sample_rate": 44100,
    "seconds": 4.667210884353741,
    "peak": 0.349884033203125,
    "generation_seconds": 13.183585691032931
  },
  {
    "sentence_id": "hb-c04-u0001-s005",
    "text": "De beslutsfattare som utsetts genom val ska lyssna på väljarnas åsikter, eftersom väljarna annars kanske inte röstar på dem i följande val.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0001-s005.wav",
    "sample_rate": 44100,
    "seconds": 12.051156462585034,
    "peak": 0.2823486328125,
    "generation_seconds": 25.730817420000676
  },
  {
    "sentence_id": "hb-c04-u0002-s001",
    "text": "Demokrati är ett statsskick där medborgarna påverkar hurdana beslut som fattas i gemensamma frågor, vem som fattar besluten och vad statens pengar används till.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0002-s001.wav",
    "sample_rate": 44100,
    "seconds": 13.514013605442177,
    "peak": 0.3701171875,
    "generation_seconds": 27.24597609601915
  },
  {
    "sentence_id": "hb-c04-u0002-s002",
    "text": "Könet eller samhällsställningen har ingen betydelse för vem som får påverka i olika frågor.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0002-s002.wav",
    "sample_rate": 44100,
    "seconds": 7.732244897959184,
    "peak": 0.28125,
    "generation_seconds": 16.564056606963277
  },
  {
    "sentence_id": "hb-c04-u0003-s001",
    "text": "Medborgarna väljer beslutsfattare med hjälp av val.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0003-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.015510204081632,
    "peak": 0.25872802734375,
    "generation_seconds": 11.676660577009898
  },
  {
    "sentence_id": "hb-c04-u0003-s002",
    "text": "Beslutsfattarna fattar beslut om landets angelägenheter genom att diskutera, rösta och göra kompromisser.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0003-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.195102040816327,
    "peak": 0.44482421875,
    "generation_seconds": 18.93012503097998
  },
  {
    "sentence_id": "hb-c04-u0004-s001",
    "text": "En demokrati kan vara direkt, deltagande eller representativ.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0004-s001.wav",
    "sample_rate": 44100,
    "seconds": 5.572789115646258,
    "peak": 0.320892333984375,
    "generation_seconds": 11.383522813033778
  },
  {
    "sentence_id": "hb-c04-u0004-s002",
    "text": "Med direkt demokrati avses till exempel att en fråga avgörs genom ett massmöte eller en folkomröstning.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0004-s002.wav",
    "sample_rate": 44100,
    "seconds": 8.986122448979591,
    "peak": 0.384552001953125,
    "generation_seconds": 18.470268881996162
  },
  {
    "sentence_id": "hb-c04-u0004-s003",
    "text": "Beslutet baserar sig direkt på medborgarnas åsikt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0004-s003.wav",
    "sample_rate": 44100,
    "seconds": 4.597551020408163,
    "peak": 0.42620849609375,
    "generation_seconds": 11.315095422032755
  },
  {
    "sentence_id": "hb-c04-u0004-s004",
    "text": "Majoritetens åsikt vinner.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0004-s004.wav",
    "sample_rate": 44100,
    "seconds": 2.8560544217687074,
    "peak": 0.272918701171875,
    "generation_seconds": 6.478105497022625
  },
  {
    "sentence_id": "hb-c04-u0004-s005",
    "text": "När en medborgare deltar i en omröstning kan hen direkt påverka resultatet av den.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0004-s005.wav",
    "sample_rate": 44100,
    "seconds": 7.244625850340136,
    "peak": 0.271331787109375,
    "generation_seconds": 14.49500758596696
  },
  {
    "sentence_id": "hb-c04-u0005-s001",
    "text": "Direkt demokrati är svår att genomföra på statlig nivå, eftersom människorna är många.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0005-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.732244897959184,
    "peak": 0.32659912109375,
    "generation_seconds": 14.309214090986643
  },
  {
    "sentence_id": "hb-c04-u0005-s002",
    "text": "I en direkt demokrati borde varje medborgare ägna mycket tid åt att bestämma om gemensamma angelägenheter genom att delta i möten, omröstningar och olika val.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0005-s002.wav",
    "sample_rate": 44100,
    "seconds": 13.235374149659863,
    "peak": 0.337371826171875,
    "generation_seconds": 24.710668056970462
  },
  {
    "sentence_id": "hb-c04-u0005-s003",
    "text": "Därför avgörs endast en del frågor i många demokratiska länder med hjälp av direkt folkstyre.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0005-s003.wav",
    "sample_rate": 44100,
    "seconds": 8.080544217687075,
    "peak": 0.275054931640625,
    "generation_seconds": 18.164420202956535
  },
  {
    "sentence_id": "hb-c04-u0005-s004",
    "text": "I Finland ordnades till exempel en rådgivande folkomröstning år nittonhundranittiofyra om huruvida Finland borde gå med i Europeiska unionen eller inte.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0005-s004.wav",
    "sample_rate": 44100,
    "seconds": 13.305034013605443,
    "peak": 0.28399658203125,
    "generation_seconds": 26.968834865023382
  },
  {
    "sentence_id": "hb-c04-u0006-s001",
    "text": "Deltagande demokrati betyder olika sätt för människor att på ett friare sätt delta i det gemensamma beslutsfattandet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0006-s001.wav",
    "sample_rate": 44100,
    "seconds": 9.613061224489796,
    "peak": 0.3409423828125,
    "generation_seconds": 21.393299591029063
  },
  {
    "sentence_id": "hb-c04-u0006-s002",
    "text": "Deltagande demokrati är till exempel medborgarverksamhet eller att kommunen ordnar en invånarpanel, dit alla invånare i kommunen bjuds in för att diskutera en fråga som det ska fattas beslut i.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0006-s002.wav",
    "sample_rate": 44100,
    "seconds": 15.952108843537415,
    "peak": 0.5692138671875,
    "generation_seconds": 33.65866505203303
  },
  {
    "sentence_id": "hb-c04-u0006-s003",
    "text": "Panelen fattar inget direkt beslut, men politikerna lyssnar på den och tar invånarnas synpunkter i beaktande när de fattar beslutet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0006-s003.wav",
    "sample_rate": 44100,
    "seconds": 11.075918367346938,
    "peak": 0.42852783203125,
    "generation_seconds": 25.680563886009622
  },
  {
    "sentence_id": "hb-c04-u0007-s001",
    "text": "I demokratiska stater tillämpas i allmänhet representativ demokrati, som kan kompletteras med direkt och deltagande demokrati.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0007-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.936598639455783,
    "peak": 0.359893798828125,
    "generation_seconds": 20.637735948024783
  },
  {
    "sentence_id": "hb-c04-u0007-s002",
    "text": "Så är fallet också i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0007-s002.wav",
    "sample_rate": 44100,
    "seconds": 3.0650340136054424,
    "peak": 0.4007568359375,
    "generation_seconds": 7.982013041037135
  },
  {
    "sentence_id": "hb-c04-u0007-s003",
    "text": "I Finland hålls regelbundet val, där medborgarna väljer representanter för sig.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0007-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.965986394557823,
    "peak": 0.3160400390625,
    "generation_seconds": 14.296010688995011
  },
  {
    "sentence_id": "hb-c04-u0007-s004",
    "text": "Representanterna bedriver politiskt arbete i samhället och representerar vanliga medborgare.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0007-s004.wav",
    "sample_rate": 44100,
    "seconds": 8.010884353741497,
    "peak": 0.37249755859375,
    "generation_seconds": 17.6085373829701
  },
  {
    "sentence_id": "hb-c04-u0008-s001",
    "text": "När en kandidat får tillräckligt många röster i ett val blir hen vald.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0008-s001.wav",
    "sample_rate": 44100,
    "seconds": 6.199727891156463,
    "peak": 0.2476806640625,
    "generation_seconds": 12.83066866901936
  },
  {
    "sentence_id": "hb-c04-u0008-s002",
    "text": "Då får hen fullmakt från folket att fatta beslut i gemensamma frågor för andras räkning.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0008-s002.wav",
    "sample_rate": 44100,
    "seconds": 7.174965986394557,
    "peak": 0.3634033203125,
    "generation_seconds": 14.572184600983746
  },
  {
    "sentence_id": "hb-c04-u0008-s003",
    "text": "Väljarna överlåter alltså en del av sin makt till personen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0008-s003.wav",
    "sample_rate": 44100,
    "seconds": 5.572789115646258,
    "peak": 0.2850341796875,
    "generation_seconds": 10.970017426006962
  },
  {
    "sentence_id": "hb-c04-u0008-s004",
    "text": "Med hjälp av val väljer finländarna till exempel medlemmar i riksdagen, det vill säga riksdagsledamöter, ledamöter i kommunfullmäktige, som fattar beslut i kommunerna, och ledamöter i välfärdsområdesfullmäktige, som fattar beslut i välfärdsområdena.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0008-s004.wav",
    "sample_rate": 44100,
    "seconds": 21.455238095238094,
    "peak": 0.3848876953125,
    "generation_seconds": 41.95491759298602
  },
  {
    "sentence_id": "hb-c04-u0009-s001",
    "text": "I en representativ demokrati arbetar representanterna på heltid eller deltid och beslutar om gemensamma frågor för medborgarnas räkning.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0009-s001.wav",
    "sample_rate": 44100,
    "seconds": 11.633197278911565,
    "peak": 0.330352783203125,
    "generation_seconds": 267.0736536140321
  },
  {
    "sentence_id": "hb-c04-u0009-s002",
    "text": "Då kan de övriga medborgarna fokusera på sina egna arbeten.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0009-s002.wav",
    "sample_rate": 44100,
    "seconds": 5.363809523809524,
    "peak": 0.271881103515625,
    "generation_seconds": 5.937546709959861
  },
  {
    "sentence_id": "hb-c04-u0010-s001",
    "text": "En representant får fatta självständiga beslut och är inte tvungen att följa väljarnas vilja.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0010-s001.wav",
    "sample_rate": 44100,
    "seconds": 8.289523809523809,
    "peak": 0.34954833984375,
    "generation_seconds": 11.056169986026362
  },
  {
    "sentence_id": "hb-c04-u0010-s002",
    "text": "Väljarna är ändå intresserade av hur representanterna sköter sitt arbete och hurdana beslut de fattar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0010-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.125442176870749,
    "peak": 0.3316650390625,
    "generation_seconds": 16.40774632798275
  },
  {
    "sentence_id": "hb-c04-u0010-s003",
    "text": "Till exempel republikens president, ministrar och riksdagsledamöter måste ofta motivera sina beslut för väljarna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0010-s003.wav",
    "sample_rate": 44100,
    "seconds": 9.961360544217687,
    "peak": 0.329376220703125,
    "generation_seconds": 16.91383405897068
  },
  {
    "sentence_id": "hb-c04-u0010-s004",
    "text": "Mediernas uppgift är att följa och rapportera om hur representanterna använder makten de fått.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0010-s004.wav",
    "sample_rate": 44100,
    "seconds": 8.359183673469389,
    "peak": 0.305511474609375,
    "generation_seconds": 14.084834171982948
  },
  {
    "sentence_id": "hb-c04-u0011-s001",
    "text": "Politiska beslutsfattare måste sätta sig in i komplicerade frågor på kort tid.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0011-s001.wav",
    "sample_rate": 44100,
    "seconds": 6.965986394557823,
    "peak": 0.30303955078125,
    "generation_seconds": 14.724331956997048
  },
  {
    "sentence_id": "hb-c04-u0011-s002",
    "text": "Statens och kommunernas medel är begränsade.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0011-s002.wav",
    "sample_rate": 44100,
    "seconds": 4.179591836734694,
    "peak": 0.2730712890625,
    "generation_seconds": 8.106835612969007
  },
  {
    "sentence_id": "hb-c04-u0011-s003",
    "text": "Besluten om till vad de gemensamma pengarna ska användas och hur mycket måste vara sådana att politikerna kan motivera dem för sina väljare och uppbackare.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0011-s003.wav",
    "sample_rate": 44100,
    "seconds": 13.235374149659863,
    "peak": 0.293670654296875,
    "generation_seconds": 21.424710512976162
  },
  {
    "sentence_id": "hb-c04-u0011-s004",
    "text": "Om en representant vill att väljarna ska rösta på hen på nytt i nästa val, måste hen försöka uppfylla de löften som hen har gett väljarna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0011-s004.wav",
    "sample_rate": 44100,
    "seconds": 11.77251700680272,
    "peak": 0.355072021484375,
    "generation_seconds": 25.14001188898692
  },
  {
    "sentence_id": "hb-c04-u0012-s001",
    "text": "I en del länder sker valfusk av olika orsaker, och röstantalen eller valresultatet kan mycket väl förfalskas.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c04-demokrati/narration/hb-c04-u0012-s001.wav",
    "sample_rate": 44100,
    "seconds": 9.822040816326531,
    "peak": 0.29766845703125,
    "generation_seconds": 20.503974912979174
  },
  {
    "sentence_id": "hb-c04-u0012-s002",
