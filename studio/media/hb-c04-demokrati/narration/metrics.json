  },
  {
    "sentence_id": "hb-c04-u0014-s002",
    "text": "Det betyder ändå inte att majoriteten fram till nästa val skulle ha rätt att diskriminera eller förtrycka minoriteten, det vill säga dem som är av en annan åsikt än majoriteten.",
    "engine": "supertonic",
    "voice": "F1",
