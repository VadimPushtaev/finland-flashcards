    "seconds": 5.294149659863946,
    "peak": 0.52288818359375,
    "generation_seconds": 11.77833537699189,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0031-s005",
    "text": "Arbetsklädseln är ofta ledig och informell i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0031-s005.wav",
