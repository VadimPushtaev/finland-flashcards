    "generation_seconds": 13.493273903965019,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0035-s003",
    "text": "I allmänhet hjälper de anställda varandra och utför flexibelt olika uppgifter enligt behov.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0035-s003.wav",
    "sample_rate": 44100,
    "seconds": 7.9412244897959186,
    "peak": 0.339691162109375,
    "generation_seconds": 20.297169605037197,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0035-s004",
    "text": "Människorna litar på varandra och på att var och en utför överenskomna arbetsuppgifter.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0035-s004.wav",
    "sample_rate": 44100,
