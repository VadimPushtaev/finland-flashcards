    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0030-s004",
    "text": "Människorna tillbringar inte nödvändigtvis tid med sina arbetskamrater när de är lediga.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0030-s004.wav",
    "sample_rate": 44100,
    "seconds": 7.9412244897959186,
