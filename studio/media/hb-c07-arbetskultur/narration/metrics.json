    "generation_seconds": 14.976405093912035,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0030-s005",
    "text": "Undantag är gemensamma fester på arbetsplatsen, till exempel julfester och rekreationsdagar.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0030-s005.wav",
