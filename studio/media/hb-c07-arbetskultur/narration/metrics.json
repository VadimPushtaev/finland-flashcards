    "generation_seconds": 13.73730433091987,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0031-s001",
    "text": "Hierarkin på de finländska arbetsplatserna är i allmänhet låg.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0031-s001.wav",
