    "peak": 0.252899169921875,
    "generation_seconds": 17.095136150950566,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0036-s001",
    "text": "På arbetsplatsen är människorna vanligtvis ganska rättframma och säger vad de tänker.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0036-s001.wav",
    "sample_rate": 44100,
    "seconds": 7.523265306122449,
    "peak": 0.37615966796875,
    "generation_seconds": 18.217526555992663,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0036-s002",
    "text": "Det är vanligt att gå rakt på sak utan att först prata om ditt och datt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0036-s002.wav",
    "sample_rate": 44100,
    "seconds": 6.199727891156463,
    "peak": 0.375885009765625,
    "generation_seconds": 21.202138109947555,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0036-s003",
    "text": "I arbetet diskuterar man ofta direkt också negativa saker.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0036-s003.wav",
    "sample_rate": 44100,
    "seconds": 5.363809523809524,
    "peak": 0.401580810546875,
    "generation_seconds": 16.1236014009919,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0036-s004",
    "text": "Man behöver alltså inte ta illa upp om till exempel chefen eller en arbetskamrat säger att arbetet har utförts dåligt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0036-s004.wav",
    "sample_rate": 44100,
    "seconds": 10.100680272108843,
    "peak": 0.33203125,
    "generation_seconds": 27.919942863984033,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0036-s005",
    "text": "Alla misslyckas ibland i arbetet.",
    "engine": "supertonic",
    "voice": "F1",
