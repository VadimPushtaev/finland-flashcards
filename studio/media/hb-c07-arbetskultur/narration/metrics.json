    "generation_seconds": 12.701053725089878,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0031-s002",
    "text": "Chefen skiljer sig nästan inte alls från mängden och utför rätt så liknande arbete som de övriga.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0031-s002.wav",
    "sample_rate": 44100,
    "seconds": 8.150204081632653,
    "peak": 0.39788818359375,
    "generation_seconds": 16.812017468037084,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0031-s003",
    "text": "Chefen klär sig på samma sätt som de andra och hen tilltalas med förnamn.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0031-s003.wav",
    "sample_rate": 44100,
    "seconds": 6.339047619047619,
