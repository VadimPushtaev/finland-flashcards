    "seconds": 6.060408163265306,
    "peak": 0.605316162109375,
    "generation_seconds": 13.933535460033454,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0030-s003",
    "text": "Arbetet börjar och slutar en viss tid.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0030-s003.wav",
