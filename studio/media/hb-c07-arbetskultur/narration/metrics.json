    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0029-s003",
    "text": "Att favorisera släktingar eller vänner vid rekrytering oberoende av om personen är lämplig för arbetsuppgiften är inte acceptabelt i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
