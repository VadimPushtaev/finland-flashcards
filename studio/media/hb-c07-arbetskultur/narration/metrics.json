    "generation_seconds": 13.756737479940057,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0030-s007",
    "text": "Till arbetsplatsens fester blir de anställdas makar inte så ofta inbjudna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0030-s007.wav",
