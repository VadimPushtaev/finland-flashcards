    "generation_seconds": 13.657187136006542,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0030-s002",
    "text": "På arbetstid arbetar arbetstagaren, och på fritiden har hen egen tid.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0030-s002.wav",
