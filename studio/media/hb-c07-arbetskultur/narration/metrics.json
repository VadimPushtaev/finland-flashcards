    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0030-s006",
    "text": "Syftet med dem är att förbättra gemenskapen på arbetsplatsen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0030-s006.wav",
    "sample_rate": 44100,
