    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0031-s004",
    "text": "Man kan alltid gå till chefen om man har frågor om arbetet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0031-s004.wav",
