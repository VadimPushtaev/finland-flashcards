    "generation_seconds": 13.28891907504294,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0031-s006",
    "text": "Löneskillnaderna mellan chefen och de anställda är ganska små.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0031-s006.wav",
    "sample_rate": 44100,
    "seconds": 5.572789115646258,
    "peak": 0.306182861328125,
    "generation_seconds": 13.175632243975997,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0032-s001",
    "text": "Chefen är ingen absolut auktoritet, utan vanligtvis ger hen de anställda möjlighet att planera sitt arbete och komma med idéer.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0032-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.518639455782314,
    "peak": 0.3126220703125,
    "generation_seconds": 24.99618205393199,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0032-s002",
    "text": "Chefen förväntar sig att de anställda är initiativrika och samvetsgrant utför de överenskomna arbetsuppgifterna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0032-s002.wav",
    "sample_rate": 44100,
    "seconds": 9.891700680272109,
    "peak": 0.290374755859375,
    "generation_seconds": 23.727737465989776,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0032-s003",
    "text": "Hen övervakar inte hela tiden de anställda, utan litar på att arbetet blir gjort.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0032-s003.wav",
    "sample_rate": 44100,
    "seconds": 7.035646258503402,
    "peak": 0.280975341796875,
    "generation_seconds": 16.309537633904256,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0032-s004",
    "text": "Chefen har ändå rätt att leda arbetet och ge de anställda instruktioner och order som de förväntas följa.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0032-s004.wav",
    "sample_rate": 44100,
    "seconds": 8.916462585034013,
    "peak": 0.30181884765625,
    "generation_seconds": 20.55712486000266,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0033-s001",
    "text": "Den anställda får på eget initiativ göra sådant på arbetsplatsen som hen märker att skulle vara bra att blir gjort.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0033-s001.wav",
    "sample_rate": 44100,
    "seconds": 9.822040816326531,
    "peak": 0.261688232421875,
    "generation_seconds": 21.158059139037505,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0033-s002",
    "text": "När en arbetsuppgift är klar börjar den anställda på eget initiativ med nästa, och när hen märker att något behöver göras gör hen det.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0033-s002.wav",
    "sample_rate": 44100,
    "seconds": 11.284897959183674,
    "peak": 0.30169677734375,
    "generation_seconds": 28.178688485058956,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0033-s003",
    "text": "Personen väntar inte på att chefen ska säga till hen att göra det.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0033-s003.wav",
    "sample_rate": 44100,
    "seconds": 5.642448979591837,
    "peak": 0.322418212890625,
    "generation_seconds": 12.59898701601196,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0033-s004",
    "text": "Om den anställda inte vet vad hen ska göra eller hur en arbetsuppgift ska utföras, frågar hen chefen eller arbetskamraterna.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0033-s004.wav",
    "sample_rate": 44100,
    "seconds": 10.65795918367347,
    "peak": 0.359130859375,
    "generation_seconds": 21.473566967993975,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0034-s001",
    "text": "Utöver initiativrikedom är också punktlighet, flit och samvetsgrannhet uppskattade egenskaper hos arbetstagare i Finland.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0034-s001.wav",
    "sample_rate": 44100,
    "seconds": 10.518639455782314,
    "peak": 0.3218994140625,
    "generation_seconds": 27.947715373011306,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0034-s002",
    "text": "Om en anställd ofta kommer för sent till jobbet eller inte följer tidsplaner betraktas hen som opålitlig, vilket till och med kan vara en orsak till att avsluta anställningsförhållandet.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0034-s002.wav",
    "sample_rate": 44100,
    "seconds": 15.32517006802721,
    "peak": 0.323089599609375,
    "generation_seconds": 34.18825760693289,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0034-s003",
    "text": "Under arbetstid strävar man efter att vara flitig och utföra sitt arbete så effektivt som möjligt.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0034-s003.wav",
    "sample_rate": 44100,
    "seconds": 8.359183673469389,
    "peak": 0.313690185546875,
    "generation_seconds": 20.51813100592699,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0034-s004",
    "text": "Samvetsgrannhet betyder att den anställda utför de uppgifter som getts hen så bra som hen kan och att man kan lita på hen.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0034-s004.wav",
    "sample_rate": 44100,
    "seconds": 9.961360544217687,
    "peak": 0.339691162109375,
    "generation_seconds": 22.694777830969542,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0035-s001",
    "text": "På arbetsplatserna arbetar man ofta i team.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0035-s001.wav",
    "sample_rate": 44100,
    "seconds": 4.1099319727891155,
    "peak": 0.39691162109375,
    "generation_seconds": 8.483168090926483,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0035-s002",
    "text": "Därför är det viktigt att kunna samarbeta med sina arbetskamrater.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0035-s002.wav",
    "sample_rate": 44100,
    "seconds": 5.921088435374149,
