    "generation_seconds": 21.262203789083287,
    "intra_op_num_threads": 2
  },
  {
    "sentence_id": "hb-c07-u0030-s001",
    "text": "I Finland är man ofta noggrann med att skilja på arbete och fritid.",
    "engine": "supertonic",
    "voice": "F1",
    "speed": 0.95,
    "seed": 42,
    "path": "studio/media/hb-c07-arbetskultur/narration/hb-c07-u0030-s001.wav",
