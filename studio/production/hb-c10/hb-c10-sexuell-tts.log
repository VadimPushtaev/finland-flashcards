{"sentence_id": "hb-c10-u0153-s001", "text": "Forskning visar att information om sexualitet gör de unga mer ansvarsfulla samt skyddar och främjar deras hälsa.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0153-s001.wav", "sample_rate": 44100, "seconds": 9.961360544217687, "peak": 0.297943115234375, "generation_seconds": 38.17859961395152, "intra_op_num_threads": 2}
