{"sentence_id": "hb-c10-u0154-s003", "text": "De unga får lära sig att ingen behöver göra något som den inte vill när det kommer till sexualitet.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0154-s003.wav", "sample_rate": 44100, "seconds": 8.219863945578231, "peak": 0.279022216796875, "generation_seconds": 28.10703791398555, "intra_op_num_threads": 2}
{"sentence_id": "hb-c10-u0154-s004", "text": "För sexuellt umgänge behövs alltid ett tydligt samtycke av alla parter.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0154-s004.wav", "sample_rate": 44100, "seconds": 6.478367346938776, "peak": 0.36041259765625, "generation_seconds": 23.433890441199765, "intra_op_num_threads": 2}
