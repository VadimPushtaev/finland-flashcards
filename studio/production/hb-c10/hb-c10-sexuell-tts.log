{"sentence_id": "hb-c10-u0154-s001", "text": "På lektionerna i sexualundervisning i skolan får eleverna lära sig att sexualitet är en naturlig och hälsosam del av en människas liv.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0154-s001.wav", "sample_rate": 44100, "seconds": 11.702857142857143, "peak": 0.306243896484375, "generation_seconds": 37.26601407001726, "intra_op_num_threads": 2}
