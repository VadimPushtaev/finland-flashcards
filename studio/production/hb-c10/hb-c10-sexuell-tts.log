{"sentence_id": "hb-c10-u0154-s002", "text": "På lektionerna betonas viktiga värderingar inom sexualundervisningen, till exempel självbestämmanderätt och vikten av personlig integritet.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0154-s002.wav", "sample_rate": 44100, "seconds": 12.19047619047619, "peak": 0.299835205078125, "generation_seconds": 37.67661135387607, "intra_op_num_threads": 2}
