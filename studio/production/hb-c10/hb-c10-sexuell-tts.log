{"sentence_id": "hb-c10-u0152-s004", "text": "Inom sexualundervisningen behandlas också emotionella och sociala färdigheter och mångfalden av sexuella läggningar och kön.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0152-s004.wav", "sample_rate": 44100, "seconds": 10.65795918367347, "peak": 0.3289794921875, "generation_seconds": 42.52469312190078, "intra_op_num_threads": 2}
