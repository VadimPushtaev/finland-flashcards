{"sentence_id": "hb-c10-u0157-s002", "text": "Du kan använda tjänsterna vid rådgivningsbyrån eller familjecentret om du har en hemkommun i Finland.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0157-s002.wav", "sample_rate": 44100, "seconds": 8.70748299319728, "peak": 0.455474853515625, "generation_seconds": 28.94910160987638, "intra_op_num_threads": 2}
