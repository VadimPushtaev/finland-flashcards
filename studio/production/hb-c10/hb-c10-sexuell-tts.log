{"sentence_id": "hb-c10-u0153-s002", "text": "Många undersökningar har visat att sexualundervisningen inte leder till tidiga sexuella experiment eller påverkar de ungas sexuella identitet.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0153-s002.wav", "sample_rate": 44100, "seconds": 12.26013605442177, "peak": 0.27239990234375, "generation_seconds": 40.79744972893968, "intra_op_num_threads": 2}
