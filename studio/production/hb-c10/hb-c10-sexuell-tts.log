{"sentence_id": "hb-c10-u0152-s001", "text": "I skolorna i Finland får barn och unga sexualundervisning enligt sin ålder och utvecklingsnivå.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0152-s001.wav", "sample_rate": 44100, "seconds": 8.359183673469389, "peak": 0.266693115234375, "generation_seconds": 30.80486311786808, "intra_op_num_threads": 2}
