{"sentence_id": "hb-c10-u0148-s002", "text": "En del områden erbjuder avgiftsfria preventivmedel mot graviditet och könssjukdomar till alla unga under 20 eller 25 år.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sexuell/narration/hb-c10-u0148-s002.wav", "sample_rate": 44100, "seconds": 11.702857142857143, "peak": 0.4468994140625, "generation_seconds": 36.92565440107137, "intra_op_num_threads": 2}
