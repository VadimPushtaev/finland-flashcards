{"batchcomplete":"","continue":{"gsroffset":6,"continue":"gsroffset||"},"query":{"pages":{"93683250":{"pageid":93683250,"ns":6,"title":"File:Convenience foods in the grocery basket (IA conveniencefoods22harp).pdf","index":1,"imagerepository":"local","imageinfo":[{"thumburl":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Convenience_foods_in_the_grocery_basket_%28IA_conveniencefoods22harp%29.pdf/page1-500px-Convenience_foods_in_the_grocery_basket_%28IA_conveniencefoods22harp%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","thumbwidth":1000,"thumbheight":1554,"thumbattribs":{"src":"https://thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Convenience_foods_in_the_grocery_basket_%28IA_conveniencefoods22harp%29.pdf/page1-500px-Convenience_foods_in_the_grocery_basket_%28IA_conveniencefoods22harp%29.pdf.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail","decoding":"async","loading":"lazy","width":1000,"height":1554},"url":"https://upload.wikimedia.org/wikipedia/commons/1/1b/Convenience_foods_in_the_grocery_basket_%28IA_conveniencefoods22harp%29.pdf?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Convenience_foods_in_the_grocery_basket_(IA_conveniencefoods22harp).pdf","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=93683250","extmetadata":{"DateTime":{"value":"2020-08-30 16:17:46","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"<div class=\"fn\">\nConvenience foods in the grocery basket</div>","source":"commons-desc-page"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"PD US Government|FEDLINK - United States Federal Collection|Scans from the Internet Archive/unverified|CC-PD-Mark|Scans from the Internet Archive|Books uploaded by F\u00e6|Books without Wikidata item","source":"commons-categories","hidden":""},"Asses