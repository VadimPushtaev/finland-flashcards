t=thumbnail","decoding":"async","loading":"lazy","width":1920,"height":1236,"srcset":"https://thumb.wikimedia.org/wikipedia/commons/thumb/3/33/Kela_1941.jpg/3840px-Kela_1941.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail 2x"},"url":"https://upload.wikimedia.org/wikipedia/commons/3/33/Kela_1941.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Kela_1941.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=76801759","extmetadata":{"DateTime":{"value":"2023-07-26 07:37:20","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Kela 1941","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Historical Picture Collection of The Finnish Heritage Agency|Social security in Finland|Kansanel\u00e4kelaitos|Offices in Finland|1941 in Helsinki|Files from the Finnish Heritage Agency|Black and white photographs of building interiors in Helsinki|Black and white photographs of people at work in Finland","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"Artist":{"value":"<div class=\"fn value\">\nPietinen</div>","source":"commons-desc-page"},"ImageDescription":{"value":"The clerks of the Helsinki office of The Social Insurance Institution of Finland (Kela) at work in the year 1941.","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1941<div style=\"display: none;\">date QS:P571,+1941-00-00T00:00:00Z/9</div>","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external free\" href=\"https://finna.fi/Record/musketti.M012:HK19670603:45184\">https://finna.fi/Record/musketti.M012:HK19670603:45184</a><br><a rel=\"nofollow\" class=\"external free\" href=\"https://finna.fi/Cover/Show?id=museovirasto.E1DCBE8DB9E06507B4D97B813B37437A&amp;index=0&amp;size=large&amp;source=Solr\">https://finna.fi/Cover/Show?id=museovirasto.E1DCBE8DB9E06507B4D97B813B37437A&amp;index=0&amp;size=large&amp;source=Solr</a><br>Image record page in Finna: <a rel=\"nofollow\" class=\"external text\" href=\"https://www.finna.fi/Record/museovirasto.E1DCBE8DB9E06507B4D97B813B37437A\">museovirasto.E1DCBE8DB9E06507B4D97B813B37437A</a>","source":"commons-desc-page"},"Permission":{"value":"Tiedostoa voi k\u00e4ytt\u00e4\u00e4 vapaasti my\u00f6s kaupallisesti. Tiedoston yhteydess\u00e4 on mainittava tekij\u00e4 ja/tai kuvaaja sek\u00e4 kokoelman ja organisaation nimi. K\u00e4ytt\u00f6ohjeet: K\u00e4ytt\u00e4j\u00e4 vastaa tekij\u00e4noikeuksien ja yksityisyyden suojan kunnioittamisesta sek\u00e4 siit\u00e4, ett\u00e4 tiedot ovat oikein. Henkil\u00f6kuvien k\u00e4ytt\u00f6 markkinoinnissa ja mainonnassa on kielletty ilman kuvassa olevan henkil\u00f6n suostumusta. K\u00e4ytt\u00e4j\u00e4 vastaa lupien hankkimisesta tiedostoissa esiintyvien henkil\u00f6iden, teosten ja tavaramerkkien osalta. K\u00e4ytt\u00e4j\u00e4 vastaa k\u00e4ytt\u00f6tarkoituksen mukaisesta tiedostonk\u00e4sittelyst\u00e4. Pyyd\u00e4mme toimittamaan Museoviraston kirjastoon vapaakappaleen painetusta julkaisusta, jossa tiedostoa on k\u00e4ytetty. Jos haluat parempilaatuisen tiedoston, ota yhteytt\u00e4 Museoviraston Kuvakokoelmiin (kuvakokoelmat@museovirasto.fi).","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"CC BY 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 4.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/4.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-4.0","source":"commons-templates","hidden":""}}}]},"47680871":{"pageid":47680871,"ns":6,"