2026-11-03T05:14:27.741082+00:00 hb-c10-sjukdom tts: PID 171903 running
{"sentence_id": "hb-c10-u0197-s001", "text": "Om du blir sjuk eller råkar ut för en olycka har du rätt att stanna hemma från arbetet.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-sjukdom/narration/hb-c10-u0197-s001.wav", "sample_rate": 44100, "seconds": 7.592925170068027, "peak": 0.2818603515625, "generation_seconds": 29.40420456090942, "intra_op_num_threads": 2}
