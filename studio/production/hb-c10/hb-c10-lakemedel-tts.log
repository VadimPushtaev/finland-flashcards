{"sentence_id": "hb-c10-u0107-s002", "text": "Ta reda på begränsningarna också om du vill beställa läkemedel till Finland per post.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-lakemedel/narration/hb-c10-u0107-s002.wav", "sample_rate": 44100, "seconds": 7.662585034013605, "peak": 0.24932861328125, "generation_seconds": 17.956820833031088, "intra_op_num_threads": 2}
