{"sentence_id": "hb-c10-u0006-s004", "text": "Varje sökandes livssituation behandlas individuellt när F P A fattar beslut om bidrag.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-valfard/narration-resume-chunk-02/hb-c10-u0006-s004.wav", "sample_rate": 44100, "seconds": 8.219863945578231, "peak": 0.346649169921875, "generation_seconds": 14.056844713166356, "intra_op_num_threads": 2}
{"sentence_id": "hb-c10-u0007-s001", "text": "Sökandens livssituation och behov av understöd är ofta mycket olika.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-valfard/narration-resume-chunk-02/hb-c10-u0007-s001.wav", "sample_rate": 44100, "seconds": 6.548027210884354, "peak": 0.266082763671875, "generation_seconds": 10.495552168926224, "intra_op_num_threads": 2}
