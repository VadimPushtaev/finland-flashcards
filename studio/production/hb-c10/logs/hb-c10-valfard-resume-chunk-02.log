{"sentence_id": "hb-c10-u0007-s003", "text": "Du ska alltid utreda din egen situation individuellt.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c10-valfard/narration-resume-chunk-02/hb-c10-u0007-s003.wav", "sample_rate": 44100, "seconds": 4.806530612244898, "peak": 0.495208740234375, "generation_seconds": 8.195456399116665, "intra_op_num_threads": 2}
