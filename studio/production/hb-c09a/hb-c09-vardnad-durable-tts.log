{"sentence_id": "hb-c09-u0153-s001", "text": "religion", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050123290268Z/hb-c09-u0153-s001.wav", "sample_rate": 44100, "seconds": 1.6718367346938776, "peak": 0.297515869140625, "generation_seconds": 5.350751074030995, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0154-s001", "text": "utbildning", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050123290268Z/hb-c09-u0154-s001.wav", "sample_rate": 44100, "seconds": 1.811156462585034, "peak": 0.36993408203125, "generation_seconds": 7.834683594061062, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0155-s001", "text": "hälsovård", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050123290268Z/hb-c09-u0155-s001.wav", "sample_rate": 44100, "seconds": 1.8808163265306121, "peak": 0.455780029296875, "generation_seconds": 6.5356485459487885, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0156-s001", "text": "disponering av barnets egendom", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050235273572Z/hb-c09-u0156-s001.wav", "sample_rate": 44100, "seconds": 3.274013605442177, "peak": 0.285125732421875, "generation_seconds": 9.155565890017897, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0157-s001", "text": "Också till exempel för en passansökan behövs båda föräldrarnas samtycke.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050235273572Z/hb-c09-u0157-s001.wav", "sample_rate": 44100, "seconds": 6.548027210884354, "peak": 0.349395751953125, "generation_seconds": 15.593031751923263, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0158-s001", "text": "När föräldrarna har gemensam vårdnad måste de kunna komma överens om saker med varandra.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050235273572Z/hb-c09-u0158-s001.wav", "sample_rate": 44100, "seconds": 7.87156462585034, "peak": 0.247283935546875, "generation_seconds": 22.341987129999325, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0158-s002", "text": "Det viktigaste är att föräldrarna tänker på barnets bästa när de fattar beslut.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050235273572Z/hb-c09-u0158-s002.wav", "sample_rate": 44100, "seconds": 6.826666666666667, "peak": 0.37750244140625, "generation_seconds": 21.082630553049967, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0159-s001", "text": "Barnet har rätt att ha kontakt med båda sina föräldrar efter skilsmässan.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050235273572Z/hb-c09-u0159-s001.wav", "sample_rate": 44100, "seconds": 6.408707482993197, "peak": 0.334716796875, "generation_seconds": 21.87966686906293, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0159-s002", "text": "Han eller hon har också rätt att träffa den förälder som han eller hon inte bor med.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050235273572Z/hb-c09-u0159-s002.wav", "sample_rate": 44100, "seconds": 6.965986394557823, "peak": 0.276641845703125, "generation_seconds": 21.51283762208186, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0160-s001", "text": "Umgängesrätten kan till exempel innebära att barnet bor hos den ena föräldern och träffar den andra föräldern vartannat veckoslut och dessutom vissa tider under loven.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050235273572Z/hb-c09-u0160-s001.wav", "sample_rate": 44100, "seconds": 13.931972789115646, "peak": 0.39495849609375, "generation_seconds": 34.71492146118544, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0160-s002", "text": "Om barnet är mycket litet kan umgänget ordnas bara över dagen.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050235273572Z/hb-c09-u0160-s002.wav", "sample_rate": 44100, "seconds": 5.712108843537415, "peak": 0.269500732421875, "generation_seconds": 13.890803956892341, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0161-s001", "text": "Umgängesrätten kan också vara så omfattande att barnet bor lika mycket hos båda föräldrarna.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050545248643Z/hb-c09-u0161-s001.wav", "sample_rate": 44100, "seconds": 8.010884353741497, "peak": 0.33197021484375, "generation_seconds": 21.682719509117305, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0161-s002", "text": "Officiellt kan barnet dock bara ha en adress.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050545248643Z/hb-c09-u0161-s002.wav", "sample_rate": 44100, "seconds": 4.179591836734694, "peak": 0.26202392578125, "generation_seconds": 11.981397117022425, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0161-s003", "text": "Låt alltid barnets intressen gå först när ni fattar beslut.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050545248643Z/hb-c09-u0161-s003.wav", "sample_rate": 44100, "seconds": 5.294149659863946, "peak": 0.474578857421875, "generation_seconds": 13.116155704017729, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0162-s001", "text": "Vid problem med umgänget kan du kontakta barnatillsyningsmannen.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050545248643Z/hb-c09-u0162-s001.wav", "sample_rate": 44100, "seconds": 5.712108843537415, "peak": 0.296295166015625, "generation_seconds": 13.677545794984326, "intra_op_num_threads": 2}
{"sentence_id": "hb-c09-u0162-s002", "text": "Barnatillsyningsmannen ordnar ett möte med föräldrarna.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c09-vardnad/narration-resume-20261103T050545248643Z/hb-c09-u0162-s002.wav", "sample_rate": 44100, "seconds": 5.085170068027211, "peak": 0.3179931640625, "generation_seconds": 12.64499279204756, "intra_op_num_threads": 2}
