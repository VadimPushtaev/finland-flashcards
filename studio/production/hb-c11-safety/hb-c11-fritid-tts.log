{"sentence_id": "hb-c11-u0344-s002", "text": "Också många organisationer och församlingar bedriver ungdomsarbete.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c11-fritid/narration/hb-c11-u0344-s002.wav", "sample_rate": 44100, "seconds": 6.060408163265306, "peak": 0.264129638671875, "generation_seconds": 21.49827832588926, "intra_op_num_threads": 2}
