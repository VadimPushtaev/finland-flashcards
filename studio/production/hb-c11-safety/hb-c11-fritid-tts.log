{"sentence_id": "hb-c11-u0345-s001", "text": "Folk i Finland är aktiva motionärer och olika motionshobbyer kan hjälpa dig att lära känna människor och få nya vänner.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c11-fritid/narration/hb-c11-u0345-s001.wav", "sample_rate": 44100, "seconds": 10.518639455782314, "peak": 0.294921875, "generation_seconds": 32.582803026074544, "intra_op_num_threads": 2}
