{"sentence_id": "hb-c11-u0345-s002", "text": "Ledd motion ordnas till exempel av olika idrottssällskap som ofta drivs med frivilligarbete.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c11-fritid/narration/hb-c11-u0345-s002.wav", "sample_rate": 44100, "seconds": 8.6378231292517, "peak": 0.27935791015625, "generation_seconds": 25.184749491978437, "intra_op_num_threads": 2}
