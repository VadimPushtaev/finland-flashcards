                "value": "2021-09-22 17:16:04",
                "source": "mediawiki-metadata",
                "hidden": ""
              },
              "ObjectName": {
                "value": "SaunaIceTower",
                "source": "mediawiki-metadata"
              },
              "CommonsMetadataExtension": {
                "value": 1.2,
                "source": "extension",
                "hidden": ""
