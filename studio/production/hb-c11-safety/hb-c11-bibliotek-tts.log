{"sentence_id": "hb-c11-u0329-s001", "text": "På biblioteket kan du även låna tidskrifter, e-böcker samt CD- och DVD-skivor.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c11-bibliotek/narration/hb-c11-u0329-s001.wav", "sample_rate": 44100, "seconds": 7.383945578231293, "peak": 0.29644775390625, "generation_seconds": 27.34887225087732, "intra_op_num_threads": 2}
{"sentence_id": "hb-c11-u0330-s001", "text": "Bibliotekets tjänster är kostnadsfria för klienten.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c11-bibliotek/narration/hb-c11-u0330-s001.wav", "sample_rate": 44100, "seconds": 4.73687074829932, "peak": 0.275360107421875, "generation_seconds": 19.218810602091253, "intra_op_num_threads": 2}
