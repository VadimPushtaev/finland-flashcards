{"sentence_id": "hb-c11-u0330-s002", "text": "Flerspråkiga biblioteket har material på över 80 språk.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c11-bibliotek/narration/hb-c11-u0330-s002.wav", "sample_rate": 44100, "seconds": 5.712108843537415, "peak": 0.2850341796875, "generation_seconds": 21.505117177963257, "intra_op_num_threads": 2}
