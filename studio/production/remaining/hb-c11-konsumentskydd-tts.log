{"sentence_id": "hb-c11-u0190-s002", "text": "Konsumentskyddslagen tryggar konsumentens rättigheter i Finland.", "engine": "supertonic", "voice": "F1", "speed": 0.95, "seed": 42, "path": "studio/media/hb-c11-konsumentskydd/narration/hb-c11-u0190-s002.wav", "sample_rate": 44100, "seconds": 5.7817687074829935, "peak": 0.316802978515625, "generation_seconds": 13.803629714995623, "intra_op_num_threads": 2}
